<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls">

    <!-- ============================================================
         按钮（对应网页版 McButton）
         ============================================================ -->

    <!-- 全局 Hover 兜底：没有自定义类的原生按钮（加载器卡片、图标按钮等）
         也统一使用与首页一致的浅蓝悬停色，避免出现主题默认的灰色 -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary7Brush}" />
    </Style>

    <Style Selector="Button.mc-btn">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="17,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!-- 全局按钮规范：无底色 + 深蓝描边 + 深蓝文字/图标（不再使用实心蓝底） -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.mc-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.mc-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <!-- Fluent 主题会在 hover 态把 ContentPresenter 的 BorderBrush 刷成透明、Foreground 刷成黑色，
             这里两者都钉回深蓝，保证边框与文字颜色不随悬停改变 -->
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.mc-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary7Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <!-- hover / pressed 只改底色：文字、图标与边框颜色保持默认值 -->
    <Style Selector="Button.mc-btn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.mc-btn:pressed">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.mc-btn:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <!-- 禁用态只降不透明度：锁回无底色 + 深蓝边框，避免被 Fluent 刷成灰底 -->
    <Style Selector="Button.mc-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <!-- 主按钮类保留（页面仍在用），但样式与普通按钮完全一致：不做任何主次强化 -->
    <Style Selector="Button.mc-btn.primary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.mc-btn.primary-soft">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <!-- ============================================================
         次级操作按钮（设置页 / 启动页的「管理实例」等统一规格）：
         浅底 + 主色描边 + 主色文字；hover 只变底色，文字与图标不变色
         规格：高 32 / 内边距 14,0 / 圆角 6 / 图标 16 / 图标与文字间距 6
         ============================================================ -->
    <Style Selector="Button.action-btn">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.action-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.action-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary7Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <!-- hover / pressed 只改底色：显式锁回文字色，避免被主题的按钮态覆盖 -->
    <Style Selector="Button.action-btn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.action-btn:pressed">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.action-btn:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <Style Selector="Button.action-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <!-- 蓝色线条按钮：主题色细描边 + 主题色文字/图标 -->
    <Style Selector="Button.line-btn">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.line-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BlockButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.line-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BlockButtonPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.line-btn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.line-btn:pressed">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.line-btn:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.line-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <!-- ============================================================
         主操作按钮：实心主色渐变 + 圆角 + 阴影，四态齐全
         规格：高 54 / 内边距 20,0 / 圆角 8 / 图标 18
         ============================================================ -->
    <Style Selector="Button.accent-btn">
        <Setter Property="Height" Value="54" />
        <Setter Property="MinHeight" Value="0" />
        <!-- 上下内边距保持对称，让标题 + 版本副标题整体垂直居中 -->
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <!-- 全局规范：默认无底色 + 深蓝外框；不再使用实心蓝 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.accent-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 悬停：只出现浅蓝底，文字/图标/边框不变 -->
    <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.accent-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary7Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <!-- 按下：轻微缩小，松开回弹 -->
    <Style Selector="Button.accent-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.accent-btn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.accent-btn:pressed">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.accent-btn:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.accent-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <!-- 启动中仍展示进度条，仅轻微降透明度 -->
    <Style Selector="Button.accent-btn.launching:disabled">
        <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="Button.accent-btn TextBlock.launch-title">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <!-- 版本号：灰色小字，弱化显示 -->
    <Style Selector="Button.accent-btn TextBlock.launch-sub">
        <Setter Property="Foreground" Value="{DynamicResource Gray2Brush}" />
    </Style>
    <Style Selector="Button.accent-btn c|HyclIcon">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <!-- 游戏运行中：右下角固定悬浮的圆形关闭按钮（48 DIP，仅图标）
         与下载进度按钮同一套：蓝底 + 白图标；悬停只轻微放大，不改任何颜色 -->
    <Style Selector="Button.stop-fab">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.stop-fab:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Button.stop-fab:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <!-- 悬停/按下只缩放：显式锁回蓝底，避免被全局 hover 规则改成浅蓝 -->
    <Style Selector="Button.stop-fab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.stop-fab:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <!-- Fluent 按钮在 hover/pressed 时会向内容下发前景色，这里把图标描边钉死为纯白，
         保证悬停只放大、图标不变色 -->
    <Style Selector="Button.stop-fab c|HyclIcon /template/ Path">
        <Setter Property="Stroke" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.stop-fab:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- 阶段式进度条：数值在 300ms 内平滑变化 -->
    <Style Selector="ProgressBar.launch-progress">
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Value" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>

    <!-- ============================================================
         确认弹窗（对应 PCL-CE 的遮罩 + 圆角卡片）
         ============================================================ -->

    <Style Selector="Border.dialog-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="BoxShadow" Value="0 18 48 0 #4D0B1B2E" />
    </Style>
    <Style Selector="TextBlock.dialog-title">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.dialog-body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Gray2Brush}" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.dialog-warning">
        <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="Border.dialog-warning TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorDarkBrush}" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 危险按钮：红色描边 + 红色文字/图标 + 默认无底色；悬停只出现淡红底，边框保持 -->
    <Style Selector="Button.mc-btn.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.mc-btn.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.mc-btn.danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.mc-btn.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSoftPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.mc-btn.danger:pressed">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.mc-btn.danger:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.mc-btn.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- ============================================================
         标题栏窗口按钮
         ============================================================ -->

    <Style Selector="Button.winbtn">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTabBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.winbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TitleHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.winbtn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- ============================================================
         标题栏标签页（胶囊形）
         ============================================================ -->

    <Style Selector="ListBox.tb-tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem">
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTabBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root"
                        Background="Transparent"
                        CornerRadius="999"
                        Height="27"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="TabContent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource TitleHoverBrush}" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 默认态：文字与图标（Path 描边）统一为白色，图标不能只靠继承 -->
    <Style Selector="ListBox.tb-tabs ListBoxItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TitleTabBrush}" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem c|HyclIcon">
        <Setter Property="Foreground" Value="{DynamicResource TitleTabBrush}" />
    </Style>
    <!-- 选中态：白色胶囊 + 文字/图标统一为 PCL-CE 顶栏选中蓝 -->
    <Style Selector="ListBox.tb-tabs ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:selected /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource TitleSelectedPillBrush}" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:selected">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTabSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TitleTabSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:selected c|HyclIcon">
        <Setter Property="Foreground" Value="{DynamicResource TitleTabSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:selected:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource TitleSelectedPillBrush}" />
    </Style>
    <Style Selector="ListBox.tb-tabs ListBoxItem:selected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TitleTabSelectedBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ============================================================
         侧边导航（对应网页版 SideNav）
         ============================================================ -->

    <Style Selector="TextBlock.side-cat">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="6,8,6,3" />
    </Style>

    <Style Selector="Button.side-item">
        <Setter Property="Width" Value="158" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="3,*">
                        <Rectangle x:Name="accent"
                                   Grid.Column="0"
                                   Fill="{DynamicResource PrimaryBrush}"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Margin="0,7"
                                   IsVisible="False" />
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="10,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.side-item:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
    </Style>
    <Style Selector="Button.side-item.active /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource Primary6Brush}" />
    </Style>
    <Style Selector="Button.side-item.active:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource Primary6Brush}" />
    </Style>
    <Style Selector="Button.side-item.active /template/ Rectangle#accent">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.side-item.active">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================================================
         页面标题 / 正文
         ============================================================ -->

    <Style Selector="TextBlock.page-heading">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="2,0,0,14" />
    </Style>

    <Style Selector="Border.page-divider">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- ============================================================
         快捷方式行
         ============================================================ -->

    <Style Selector="Button.quick-row">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.quick-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BlockButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.quick-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BlockButtonPressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 快捷方式行左侧的图标底座，与下载卡/工具卡保持同一套视觉语言 -->
    <Style Selector="Border.quick-icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
    </Style>

    <!-- ============================================================
         搜索框（胶囊形）
         ============================================================ -->

    <Style Selector="Border.search-box">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="13,5" />
        <Setter Property="Width" Value="280" />
    </Style>
    <Style Selector="Border.search-box TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         右下角悬浮下载按钮（对应 PCL-CE）：蓝色圆 + 进度环 + 下载图标
         ============================================================ -->

    <Style Selector="Button.dl-fab">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <!-- 注意：不要把模板 presenter 的 Background 设为 Transparent——
         Fluent 按钮的真实底色画在 presenter 上，透明会让整个圆钮隐身 -->
    <Style Selector="Button.dl-fab:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Button.dl-fab:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <!-- 悬停/按下只缩放：显式锁回渐变底色与白图标，避免被全局 hover 规则改成浅蓝 -->
    <Style Selector="Button.dl-fab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.dl-fab:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <!-- 游戏崩溃横幅 -->
    <Style Selector="Border.crash-banner">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="BoxShadow" Value="0 6 18 0 #33343D4A" />
    </Style>

    <!-- 皮肤选择弹窗（离线档案内置皮肤） -->
    <Style Selector="Button.skin-option">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.skin-option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.skin-option:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <!-- ============================================================
         登录对话框（添加账号）：三页签 + 设备码展示框
         ============================================================ -->

    <Style Selector="ListBox.login-tabs">
        <Setter Property="Background" Value="{DynamicResource Gray8Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ListBox.login-tabs ListBoxItem">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Gray2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="tabRoot"
                        Background="Transparent"
                        CornerRadius="6"
                        Padding="0,7">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.login-tabs ListBoxItem:pointerover /template/ Border#tabRoot">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
    </Style>
    <Style Selector="ListBox.login-tabs ListBoxItem:selected /template/ Border#tabRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BoxShadow" Value="0 1 4 0 #26343D4A" />
    </Style>
    <Style Selector="ListBox.login-tabs ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.login-code">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- 皮肤站多角色选择列表 -->
    <Style Selector="ListBox.authlib-profiles">
        <Setter Property="Background" Value="{DynamicResource Gray8Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ListBox.authlib-profiles ListBoxItem">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.authlib-profiles ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================================================
         下拉框（对应网页版 McComboBox）
         ============================================================ -->

    <Style Selector="Button.combo-trigger">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.combo-trigger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.combo-trigger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary7Brush}" />
    </Style>
    <!-- 展开态（open 类由控件代码驱动）：边框转主色，须声明在 :pointerover 之后确保覆盖 -->
    <Style Selector=".mc-combo.open /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary7Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <!-- 下拉箭头：展开时旋转 180°，节奏与网页版 .mc-combo-caret（transform .2s）一致 -->
    <Style Selector=".mc-combo /template/ Path#Caret">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=".mc-combo.open /template/ Path#Caret">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <!-- 下拉浮层：白底、细蓝边、蓝调轻投影，淡入淡出 -->
    <Style Selector="Border.combo-pop">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BoxShadow" Value="0 6 18 0 #2E1370F3" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBox.combo-list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxHeight" Value="220" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBox.combo-list ListBoxItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="itemRoot" Background="Transparent" CornerRadius="4" Padding="10,6">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.combo-list ListBoxItem:pointerover /template/ Border#itemRoot">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
    </Style>
    <Style Selector="ListBox.combo-list ListBoxItem:selected /template/ Border#itemRoot">
        <Setter Property="Background" Value="{DynamicResource Primary7Brush}" />
    </Style>
    <Style Selector="ListBox.combo-list ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================================================
         开关（对应网页版 McToggle）
         ============================================================ -->

    <Style Selector="ToggleButton.mc-toggle">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="track"
                        Width="40"
                        Height="22"
                        CornerRadius="999"
                        Background="#E7ECF4"
                        BorderBrush="#C3CFE0"
                        BorderThickness="1">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.18" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                        </Transitions>
                    </Border.Transitions>
                    <Border x:Name="knob"
                            Width="16"
                            Height="16"
                            CornerRadius="999"
                            Background="White"
                            BoxShadow="0 1 3 0 #40000000"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="2,0,0,0">
                        <Border.Transitions>
                            <Transitions>
                                <ThicknessTransition Property="Margin" Duration="0:0:0.18" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.mc-toggle:checked /template/ Border#track">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="ToggleButton.mc-toggle:checked /template/ Border#knob">
        <Setter Property="Margin" Value="20,0,0,0" />
    </Style>

    <!-- ============================================================
         玩家卡：动作按钮 / 档案行 / 类型圆点
         ============================================================ -->

    <Style Selector="Button.pa-btn">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pa-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BlockButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>
    <Style Selector="Button.pa-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BlockButtonPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <Style Selector="Button.profile-row">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.profile-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.profile-row.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary5Brush}" />
    </Style>

    <Style Selector="Border.pr-avatar">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Gray8Brush}" />
        <!-- 不裁切子元素：头像按完整正方形绘制，避免圆角把头部边缘切掉 -->
        <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style Selector="Ellipse.type-dot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource Gray4Brush}" />
    </Style>
    <Style Selector="Ellipse.type-dot.ms">
        <Setter Property="Fill" Value="{DynamicResource MsBlueBrush}" />
    </Style>

    <Style Selector="Button.back-btn">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="5,0,8,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Button.back-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <Style Selector="Button.new-profile">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" />
                    <Rectangle x:Name="dash"
                               Stroke="{DynamicResource PrimaryDeepBrush}"
                               StrokeThickness="1"
                               StrokeDashArray="4,3"
                               RadiusX="8"
                               RadiusY="8" />
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.new-profile:pointerover /template/ Border#bg">
        <Setter Property="Background" Value="{DynamicResource BlockButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.new-profile:pressed /template/ Border#bg">
        <Setter Property="Background" Value="{DynamicResource BlockButtonPressedBrush}" />
    </Style>

    <!-- ============================================================
         下载卡片 / 工具卡片
         ============================================================ -->

    <Style Selector="Button.dl-card">
        <Setter Property="Width" Value="290" />
        <Setter Property="MinHeight" Value="78" />
        <Setter Property="Padding" Value="13" />
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SoftLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="0 2 6 0 #14243D4A">
                    <Border.Transitions>
                        <Transitions>
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
                            <BrushTransition Property="Background" Duration="0:0:0.18" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.dl-card:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary5Brush}" />
        <Setter Property="BoxShadow" Value="0 8 22 0 #334890F5" />
    </Style>

    <Style Selector="Border.card-icon-box">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
        <Setter Property="BoxShadow" Value="0 3 8 0 #261370F3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         设置行（对应网页版 SettingsView 的通用行）
         ============================================================ -->

    <Style Selector="Border.setting-card">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="18,15,18,15" />
    </Style>
    <Style Selector="TextBlock.setting-card-title">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <Style Selector="Border.setting-card-rule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Gray6Brush}" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <!-- 设置行统一 170px 标签列 + 可伸缩控件列，同类控件的左边界与行高保持一致 -->
    <Style Selector="Grid.setting-row">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style Selector="TextBlock.srow-label">
        <Setter Property="Width" Value="170" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.srow-value">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Gray2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sline">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Gray2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="TextBlock.dl-empty">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Gray3Brush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,24" />
    </Style>

    <Style Selector="TextBox.stext">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox.stext:focus">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Border.slog">
        <Setter Property="Background" Value="{DynamicResource Gray8Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Gray6Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.slog TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Gray2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="ring"
                        Width="24"
                        Height="24"
                        CornerRadius="999"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        Padding="2">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.swatch.on /template/ Border#ring">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- ============================================================
         安装向导的版本列表行（对应 PCL-CE 的 MyListItem：图标 + 标题 + 右侧信息）
         ============================================================ -->

    <Style Selector="Button.ver-row">
        <!-- 固定行高：所有版本选项（含悬停变灰态）竖向尺寸一致 -->
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <!--
            自绘模板：悬停底色画在铺满按钮矩形的 Border 上（含 Padding 区域），
            不再依赖主题里的 ContentPresenter 尺寸，避免只覆盖文字/图标那一小块。
        -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="rowbg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ver-row:pointerover /template/ Border#rowbg">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
    </Style>
    <!-- 选中态略深；与悬停叠加时保持选中色，避免选中行被悬停色盖浅 -->
    <Style Selector="Button.ver-row.selected /template/ Border#rowbg">
        <Setter Property="Background" Value="{DynamicResource Primary6Brush}" />
    </Style>
    <!-- 悬停只换底色，文字与图标颜色保持不变 -->
    <Style Selector="Button.ver-row:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- 社区资源项目行：三行内容（标题/描述/标签），固定更高的统一行高 -->
    <Style Selector="Button.comp-row">
        <Setter Property="Height" Value="62" />
    </Style>

    <!-- 加载器卡片右侧状态字：加载中灰字，就绪/冲突加 dark 类转黑字 -->
    <Style Selector="TextBlock.card-status">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Gray3Brush}" />
    </Style>
    <Style Selector="TextBlock.card-status.dark">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- 小号标签（测试版/推荐/来源等）：小框、文字在框内纵向居中 -->
    <Style Selector="Border.tag">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
    </Style>

    <!-- ============================================================
         安装向导的加载器版本行（对应 PCL-CE 安装页的选中列表项）
         ============================================================ -->

    <Style Selector="Button.loader-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary8Brush}" />
    </Style>
    <Style Selector="Button.loader-item.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Primary6Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary5Brush}" />
    </Style>

    <!-- ============================================================
         轻提示（Toast）
         ============================================================ -->

    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{DynamicResource ToastBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="BoxShadow" Value="0 8 22 0 #3D1E304E" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.toast TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ============================================================
         启动过程页（对齐 PCL-CE）：步骤清单 / 账号与参数摘要 / 失败检查项
         ============================================================ -->

    <Style Selector="Border.proc-card">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SoftLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style Selector="TextBlock.step-marker">
        <Setter Property="Width" Value="18" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Gray4Brush}" />
    </Style>
    <Style Selector="TextBlock.step-marker.done">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.step-marker.active">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.step-marker.failed">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="TextBlock.step-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.step-title.done">
        <Setter Property="Foreground" Value="{DynamicResource Gray3Brush}" />
    </Style>
    <Style Selector="TextBlock.step-title.active">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.step-title.failed">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.step-title.pending">
        <Setter Property="Foreground" Value="{DynamicResource Gray4Brush}" />
    </Style>

    <Style Selector="TextBlock.param-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Gray3Brush}" />
    </Style>
    <Style Selector="TextBlock.param-value">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
