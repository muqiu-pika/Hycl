<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题画刷（运行时由 ThemeManager 按配置整体替换） -->
    <SolidColorBrush x:Key="TextBrush" Color="#343D4A" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#0B5BCB" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1370F3" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#4890F5" />
    <SolidColorBrush x:Key="Primary5Brush" Color="#96C0F9" />
    <SolidColorBrush x:Key="Primary6Brush" Color="#D5E6FD" />
    <SolidColorBrush x:Key="Primary7Brush" Color="#E0EAFD" />
    <SolidColorBrush x:Key="Primary8Brush" Color="#EAF2FE" />

    <SolidColorBrush x:Key="Gray2Brush" Color="#737373" />
    <SolidColorBrush x:Key="Gray3Brush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="Gray4Brush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="Gray5Brush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="Gray6Brush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="Gray7Brush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Gray8Brush" Color="#F5F5F5" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="#CE2111" />

    <SolidColorBrush x:Key="CardBrush" Color="#FCFCFD" Opacity="0.9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WhiteGlassBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="SoftWhiteBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#99FFFFFF" />

    <SolidColorBrush x:Key="MsBlueBrush" Color="#2F7DE1" />
    <SolidColorBrush x:Key="ToastBrush" Color="#EB343D4A" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#4C97F8" Offset="0" />
        <GradientStop Color="#1370F3" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SoftLineBrush" Color="#26343D4A" />
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#E6FFFFFF" />

    <!-- 块状/卡片按钮：默认内容色比主色浅一档；Hover/按下只换底色 -->
    <SolidColorBrush x:Key="BlockButtonTextBrush" Color="#2F7DE1" />
    <SolidColorBrush x:Key="BlockButtonNeutralTextBrush" Color="#5A6573" />
    <SolidColorBrush x:Key="BlockButtonHoverBrush" Color="#EAF2FE" />
    <SolidColorBrush x:Key="BlockButtonPressedBrush" Color="#E0EAFD" />
    <SolidColorBrush x:Key="BlockButtonSelectedBrush" Color="#D5E6FD" />
    <!-- 悬停过渡起点：与 Hover 同色系的全透明（Transparent 的白底会让过渡泛白） -->
    <SolidColorBrush x:Key="BlockButtonClearBrush" Color="#00EAF2FE" />

    <!-- 标题栏：默认白色文字/图标；选中态改为 PCL-CE 蓝，背景为白色胶囊 -->
    <SolidColorBrush x:Key="TitleTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleTabSelectedBrush" Color="#1370F3" />
    <SolidColorBrush x:Key="TitleSelectedPillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleHoverBrush" Color="#33FFFFFF" />

    <!-- 横向「左深右浅」：比上一版整体提亮一档，白字对比度仍达标 -->
    <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#1B66D6" Offset="0" />
        <GradientStop Color="#3E89EF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppBackdropBrush" StartPoint="20%,0%" EndPoint="80%,100%">
        <GradientStop Color="#CFE2FB" Offset="0" />
        <GradientStop Color="#EAF2FE" Offset="0.38" />
        <GradientStop Color="#FBFBFB" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== 启动动画层（铺满主窗口，加载完成后淡出） ===== -->
    <LinearGradientBrush x:Key="SplashBackdropBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFF5F9FE" Offset="0.5" />
        <GradientStop Color="#FFEDF3FC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SplashTitleBrush" Color="#1B2433" />
    <SolidColorBrush x:Key="SplashSubtitleBrush" Color="#6E7B8C" />
    <SolidColorBrush x:Key="SplashTrackBrush" Color="#1A1B2433" />
    <SolidColorBrush x:Key="SplashLogoShellBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SplashLogoBorderBrush" Color="#261B2433" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#552F7DE1" Offset="0" />
        <GradientStop Color="#002F7DE1" Offset="1" />
    </RadialGradientBrush>
    <ConicGradientBrush x:Key="SplashRingBrush" Angle="0">
        <GradientStop Color="#002F7DE1" Offset="0" />
        <GradientStop Color="#FF2F7DE1" Offset="0.34" />
        <GradientStop Color="#FF7FB0F7" Offset="0.5" />
        <GradientStop Color="#002F7DE1" Offset="0.68" />
        <GradientStop Color="#002F7DE1" Offset="1" />
    </ConicGradientBrush>
    <LinearGradientBrush x:Key="SplashProgressBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#002F7DE1" Offset="0" />
        <GradientStop Color="#FF4C97F8" Offset="0.5" />
        <GradientStop Color="#002F7DE1" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
