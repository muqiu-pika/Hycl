<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
        xmlns:v="clr-namespace:Hycl.Launcher.UI.Views"
        xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels;assembly=Hycl.Launcher.Core"
        xmlns:pages="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
        x:Class="Hycl.Launcher.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowCaption}"
        Width="900" Height="570"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Hycl.Launcher.UI/Assets/hycl.png"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        Background="Transparent"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent">

    <!--
        窗口外框：视觉边界就是窗口矩形本身。整窗只铺一层底色（同一张渐变以整窗尺寸铺满），
        不再内缩、不再画外投影，避免边缘出现一圈色带；圆角只靠 Win32 窗口区域裁切实现。
    -->
    <Grid Name="RootFrame" Background="Transparent">
        <Border Name="MainFrame"
                Margin="0"
                CornerRadius="10"
                ClipToBounds="True"
                Background="{DynamicResource AppBackdropBrush}">
            <Grid RowDefinitions="48,*">
                <!-- 个性化背景图片层：贴在最底层，所有页面卡片浮在其上；
                     不透明度由设置页控制，未设置时隐藏 -->
                <c:HyclImage Grid.RowSpan="2"
                             Stretch="UniformToFill"
                             IsVisible="{Binding HasBackgroundImage}"
                             Opacity="{Binding BackgroundImageOpacity}"
                             Url="{Binding BackgroundImage}" />
                <!-- ===== 标题栏：品牌 + 居中胶囊标签 + 窗口控制 ===== -->
                <Border Name="TitleBar"
                        Background="{DynamicResource TitleGradientBrush}"
                        PointerPressed="OnTitleBarPointerPressed"
                        PointerMoved="OnTitleBarPointerMoved"
                        PointerReleased="OnTitleBarPointerReleased"
                        PointerCaptureLost="OnTitleBarPointerCaptureLost">
                    <Grid ColumnDefinitions="*,Auto,*" Margin="19,0,10,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="9"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center">
                            <Image Width="26" Height="26" Source="avares://Hycl.Launcher.UI/Assets/hycl.png" />
                            <TextBlock Text="Hyplay Craft Launcher"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleTabBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <ListBox Grid.Column="1"
                                 Name="TabBar"
                                 Classes="tb-tabs"
                                 VerticalAlignment="Center"
                                 SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                 ItemsSource="{Binding Tabs}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TabItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:HyclIcon Kind="{Binding IconKey}" Width="16" Height="16" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Classes="winbtn" ToolTip.Tip="帮助" Click="OnHelpClick">
                                <c:HyclIcon Kind="help" Width="16" Height="16" Foreground="{DynamicResource TitleTabBrush}" />
                            </Button>
                            <Button Classes="winbtn" ToolTip.Tip="最小化" Click="OnMinimizeClick">
                                <c:HyclIcon Kind="minus" Width="16" Height="16" Foreground="{DynamicResource TitleTabBrush}" />
                            </Button>
                            <Button Classes="winbtn close" ToolTip.Tip="关闭" Click="OnCloseClick">
                                <c:HyclIcon Kind="close" Width="16" Height="16" Foreground="{DynamicResource TitleTabBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 页面内容 + 轻提示 ===== -->
                <Grid Name="ContentArea" Grid.Row="1">
                    <!--
                        四个页面一次性挂到这里，之后只切换 IsVisible：
                        与“每次替换 Content”相比，避免了重新挂载导致的样式重算与模板重建。
                    -->
                    <Panel Name="PageHost" ClipToBounds="True" />

                    <!-- 轻提示 -->
                    <Border Classes="toast"
                            IsVisible="{Binding IsToastVisible}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,40">
                        <TextBlock Text="{Binding ToastMessage}" />
                    </Border>

                    <!--
                        右下角悬浮下载按钮（对应 PCL-CE）：下载/安装进行中且不在下载页时显示，
                        进度环与百分比都取总体进度（与下载页、独立进度页同源）；
                        刚入队还没有进度时环改画旋转弧，避免停在 0% 看起来像卡死。
                    -->
                    <Button Name="FloatingDownloadButton"
                            Classes="dl-fab"
                            IsVisible="{Binding ShowFloatingDownload}"
                            ToolTip.Tip="{Binding FloatingDownloadTip}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,16,16"
                            Click="OnFloatingDownloadClick">
                        <Panel>
                            <!-- 等待真实进度（准备/解析/等待网络）：复用启动页的图标弹跳动画 -->
                            <c:McLoading IconSize="16"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         IsVisible="{Binding FloatingDownloadIndeterminate}" />
                            <Panel IsVisible="{Binding !FloatingDownloadIndeterminate}">
                                <c:McProgressRing Width="40"
                                                  Height="40"
                                                  Thickness="3"
                                                  TrackBrush="#26FFFFFF"
                                                  ProgressBrush="{DynamicResource PrimaryLightBrush}"
                                                  Percent="{Binding Download.Install.OverallProgressPercent}" />
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="0">
                                    <!-- 圆环中心放任务版本/资源图标，取不到时回退启动器图标 -->
                                    <c:TaskIcon Size="14"
                                                Kind="{Binding Download.Install.TaskIconKey}"
                                                Url="{Binding Download.Install.TaskIconUrl}"
                                                HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FloatingDownloadPercentText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </Panel>
                    </Button>
                </Grid>

                <!--
                    无边框窗口缩放手柄：放在可视区域内侧的 5px 贴边带（位于圆角裁切范围内），
                    不占用卡片外部的阴影留白；内容与滚动条都有 ≥15px 的页面边距，不会被压住。
                -->
                <Grid Name="ResizeLayer"
                      Grid.RowSpan="2"
                      RowDefinitions="5,*,5"
                      ColumnDefinitions="5,*,5">
                    <Border Name="rzTopLeft" Grid.Row="0" Grid.Column="0" Background="Transparent" />
                    <Border Name="rzTop" Grid.Row="0" Grid.Column="1" Background="Transparent" />
                    <Border Name="rzTopRight" Grid.Row="0" Grid.Column="2" Background="Transparent" />
                    <Border Name="rzLeft" Grid.Row="1" Grid.Column="0" Background="Transparent" />
                    <Border Name="rzRight" Grid.Row="1" Grid.Column="2" Background="Transparent" />
                    <Border Name="rzBottomLeft" Grid.Row="2" Grid.Column="0" Background="Transparent" />
                    <Border Name="rzBottom" Grid.Row="2" Grid.Column="1" Background="Transparent" />
                    <Border Name="rzBottomRight" Grid.Row="2" Grid.Column="2" Background="Transparent" />
                </Grid>

                <!--
                    启动动画层：与窗口同尺寸铺满（含标题栏），主窗口首帧即呈现，
                    加载完成后柔和淡出，下方界面随之浮现；底色与前景全部跟随浅色/深色主题。
                -->
                <Panel Name="StartupOverlay"
                       RenderTransformOrigin="50%,50%"
                       Background="{DynamicResource SplashBackdropBrush}">
                    <Panel Name="StartupOverlayContent" RenderTransformOrigin="50%,50%">
                        <!-- 顶部品牌辉光 -->
                        <Ellipse Name="StartupAmbient"
                                 Width="720"
                                 Height="420"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,-250,0,0"
                                 Opacity="0.5"
                                 Fill="{DynamicResource SplashGlowBrush}" />

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="30">
                            <!-- 图标：外发光 + 旋转光环 + 圆形底托 -->
                            <Panel Name="StartupLogo"
                                   Width="132"
                                   Height="132"
                                   HorizontalAlignment="Center">
                                <Ellipse Name="StartupGlow"
                                         Width="132"
                                         Height="132"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Opacity="0.34"
                                         Fill="{DynamicResource SplashGlowBrush}" />
                                <Ellipse Name="StartupRing"
                                         Width="110"
                                         Height="110"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         StrokeThickness="1.8"
                                         Stroke="{DynamicResource SplashRingBrush}"
                                         RenderTransformOrigin="50%,50%" />
                                <Border Width="88"
                                        Height="88"
                                        CornerRadius="44"
                                        Background="{DynamicResource SplashLogoShellBrush}"
                                        BorderBrush="{DynamicResource SplashLogoBorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Image Source="avares://Hycl.Launcher.UI/Assets/hycl.png"
                                           Width="60"
                                           Height="60"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                            </Panel>

                            <StackPanel HorizontalAlignment="Center" Spacing="9">
                                <TextBlock Text="HYPLAY CRAFT LAUNCHER"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           LetterSpacing="2.6"
                                           Foreground="{DynamicResource SplashTitleBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="正在准备你的世界…"
                                           FontSize="12.5"
                                           LetterSpacing="0.6"
                                           Foreground="{DynamicResource SplashSubtitleBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- 细进度光带：轨道 + 往复滑动的渐变高光 -->
                            <Grid Width="260"
                                  Height="3"
                                  HorizontalAlignment="Center"
                                  Margin="0,6,0,0">
                                <Border Background="{DynamicResource SplashTrackBrush}" CornerRadius="1.5" />
                                <Border Name="StartupProgress"
                                        Width="76"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource SplashProgressBrush}"
                                        BoxShadow="0 0 10 0 #664C97F8" />
                            </Grid>
                        </StackPanel>
                    </Panel>
                </Panel>
            </Grid>
        </Border>
    </Grid>
</Window>
