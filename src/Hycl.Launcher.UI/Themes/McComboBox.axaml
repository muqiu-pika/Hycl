<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls">

    <!-- 对应网页版 .mc-combo：半透明白底触发器 + 白色下拉浮层。
         下拉浮层不再由模板里的 Popup 承载，而是由控件代码挂到窗口的 OverlayLayer 上，
         避免 Avalonia 12 的 Popup 顶层宿主窗口在首帧布局时崩溃。 -->
    <ControlTheme x:Key="{x:Type c:McComboBox}" TargetType="c:McComboBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Button Name="PART_Trigger"
                            Classes="combo-trigger"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{TemplateBinding SelectedItem}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Path Grid.Column="1"
                                  Data="M6 9l6 6 6-6"
                                  Width="16"
                                  Height="16"
                                  Margin="6,0,0,0"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeJoin="Round"
                                  StrokeLineCap="Round"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
