<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hycl.Launcher.UI</RootNamespace>
    <AssemblyName>Hycl.Launcher.UI</AssemblyName>
    <Product>Hyplay Craft Launcher</Product>
    <Company>Hyplay Craft Launcher</Company>
    <AssemblyTitle>Hyplay Craft Launcher</AssemblyTitle>
    <Description>Hyplay Craft Launcher（HYCL）：基于 Avalonia 与 .NET 10 的跨平台 Minecraft 启动器</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/hycl.ico</ApplicationIcon>
    <!-- 运行时内置 COM 激活（ComActivator）与裁剪不兼容；Hycl 只通过 ComImport 消费 COM，
         不向 COM 暴露托管类，Avalonia 的 Win32 互操作也不依赖该开关。 -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- 不使用 Avalonia.Fonts.Inter：界面字体为 Microsoft YaHei UI / Consolas，
         Inter 从未被引用，移除后单文件发布少 ~1.85MB 且免去无谓的字体嵌入。 -->
  </ItemGroup>

  <!--
    单文件发布时启用压缩、ReadyToRun 与裁剪（均只在 PublishSingleFile=true 时生效，不影响日常构建）：
    - EnableCompressionInSingleFile：exe 从 101.6MB 降到 ~64MB（含 R2R），启动耗时实测无差异；
    - PublishReadyToRun：预编译托管代码，可见首帧从 ~2.9s 提前到 ~1.1s（win-x64 实测）；
    - PublishTrimmed：JSON 已全部改为 source-gen（Serialization/JsonContexts.cs + 各类内嵌套 context），
      裁剪后自包含单文件降至 ~35MB。
    framework-dependent 发布需在命令行显式关闭以上三项：压缩/裁剪不支持非自包含，
    R2R 在 framework-dependent 单文件下实测随机 coreclr fail-fast（0xc0000602，自包含不受影响）。
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hycl.Launcher.Core\Hycl.Launcher.Core.csproj" />
  </ItemGroup>

  <!--
    单文件发布时第三方原生符号（libSkiaSharp.pdb / libHarfBuzzSharp.pdb）默认仍会被拷到发布目录，
    在发布文件列表阶段剔除 .pdb，保证发布产物只有单个 exe。
  -->
  <Target Name="Hycl_ExcludeNativeSymbolsFromSingleFilePublish"
          Condition="'$(PublishSingleFile)' == 'true'"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
