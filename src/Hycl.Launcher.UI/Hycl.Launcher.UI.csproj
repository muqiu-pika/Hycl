<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hycl.Launcher.UI</RootNamespace>
    <AssemblyName>Hycl.Launcher.UI</AssemblyName>
    <Product>Hyplay Craft Launcher</Product>
    <Company>Hyplay Craft Launcher</Company>
    <AssemblyTitle>Hyplay Craft Launcher</AssemblyTitle>
    <Description>Hyplay Craft Launcher（HYCL）：基于 Avalonia 与 .NET 10 的跨平台 Minecraft 启动器</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Win32 清单与 ico 图标只属于 Windows PE 产物；发布到 linux-* / osx-* 时跳过，
         避免非 Windows 目标携带无意义的 Win32 资源（跨平台发布实测交叉编译均通过）。 -->
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win-'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win-'))">Assets/hycl.ico</ApplicationIcon>
    <!-- 运行时内置 COM 激活（ComActivator）与裁剪不兼容；Hycl 只通过 ComImport 消费 COM，
         不向 COM 暴露托管类，Avalonia 的 Win32 互操作也不依赖该开关。 -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- 不使用 Avalonia.Fonts.Inter：界面字体为 Microsoft YaHei UI / Consolas，
         Inter 从未被引用，移除后单文件发布少 ~1.85MB 且免去无谓的字体嵌入。 -->
  </ItemGroup>

  <!--
    单文件发布时启用压缩（仅在 PublishSingleFile=true 时生效，不影响日常构建）：
    - EnableCompressionInSingleFile：压缩嵌入程序集，显著缩小 exe，启动耗时实测无差异。

    PublishReadyToRun 保持 false：R2R 会把每个程序集的 IL 预编译成本机码、等于多存一份，
    实测让 win-x64 自包含单文件（原生库已嵌入）从 47.9 MB 涨到 59.2 MB（+11.3 MB，约 24%），
    换来的是首帧从 ~2.9s 提前到 ~1.1s。体积是用户最直接感知的成本，因此默认关闭；
    需要更快的冷启动时，在命令行加 -p:PublishReadyToRun=true 即可单独开启。

    PublishTrimmed 必须保持 false：插件程序集是运行时通过 Assembly.LoadFrom 动态加载的，
    不参与宿主裁剪图。裁剪器会移除 System.Runtime / netstandard 这类 type-forwarder facade
    并重写宿主 IL 的引用，而插件 dll 未经过裁剪，其 AssemblyRef 仍指向
    "System.Runtime, Version=10.0.0.0" —— 实测裁剪版单文件加载插件必然抛
    FileNotFoundException（GetExportedTypes），表现为「插件已安装并启用，工具页却没有入口」。
    更深一层：即使根住 facade，插件用到的框架成员若宿主未引用，也会被从 System.Private.CoreLib
    等程序集里裁掉，插件运行期才炸、且炸点随插件实现漂移——插件宿主场景无法安全裁剪。
    关闭裁剪后所有框架程序集都进入 bundle，外部插件才能正常解析依赖。
    framework-dependent 发布同样需显式关闭压缩/裁剪/R2R（非自包含不支持压缩，
    R2R 在 framework-dependent 单文件下实测随机 coreclr fail-fast 0xc0000602）。
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hycl.Launcher.Core\Hycl.Launcher.Core.csproj" />
  </ItemGroup>

  <!--
    发布文件列表阶段剔除非运行内容（AfterTargets 必须挂 ComputeResolvedFilesToPublishList，
    少写一个 s 会静默失效——此前 pdb 剔除目标就因挂错名字从未生效）：
    1) 第三方原生符号（libSkiaSharp.pdb / libHarfBuzzSharp.pdb），保证发布产物只有单个 exe；
    2) 调试/诊断与开发工具组件；
    3) 与目标平台无关的 Avalonia 平台头（参考 PCL-CE / HMCL「小启动器 + 按需运行时」的取舍，
       在保持自包含单文件与插件动态加载的前提下剔除确定无用的内容）。
  -->
  <Target Name="Hycl_TrimPublishOutputs"
          Condition="'$(PublishSingleFile)' == 'true'"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- 全平台：.pdb 与托管 dump / 原生调试组件（启动器崩溃分析走文本日志，
           LaunchFailureAnalyzer 不依赖 mscordaccore/mscordbi/createdump/DiaSymReader）；
           原生库不参与单文件压缩，这部分是 1:1 的体积净收益。 -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'
                                  or '%(ResolvedFileToPublish.FileName)' == 'mscordaccore'
                                  or $([System.String]::new('%(ResolvedFileToPublish.FileName)').StartsWith('mscordaccore_'))
                                  or '%(ResolvedFileToPublish.FileName)' == 'mscordbi'
                                  or '%(ResolvedFileToPublish.FileName)' == 'createdump'
                                  or $([System.String]::new('%(ResolvedFileToPublish.FileName)').StartsWith('Microsoft.DiaSymReader.Native'))
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.DesignerSupport'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Remote.Protocol'" />
      <!-- Windows 产物：Linux/macOS 专属 Avalonia 头（UsePlatformDetect 平台 guard 不会加载）；
           Vulkan/Dialogs 在 Windows 未启用（渲染走 ANGLE/GLES，文件对话框走 Win32 原生实现） -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64')
                                  and ('%(ResolvedFileToPublish.FileName)' == 'Avalonia.X11'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.FreeDesktop'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.FreeDesktop.AtSpi'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Native'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Metal'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Vulkan'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Dialogs'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Tmds.DBus.Protocol')" />
      <!-- Linux 产物：Windows/macOS 专属 Avalonia 头 -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="('$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64')
                                  and ('%(ResolvedFileToPublish.FileName)' == 'Avalonia.Win32'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Win32.Automation'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Native'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Metal')" />
      <!-- macOS 产物：Windows/Linux 专属 Avalonia 头（保留 Avalonia.Native 与 Metal） -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="('$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64')
                                  and ('%(ResolvedFileToPublish.FileName)' == 'Avalonia.Win32'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.Win32.Automation'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.X11'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.FreeDesktop'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Avalonia.FreeDesktop.AtSpi'
                                  or '%(ResolvedFileToPublish.FileName)' == 'Tmds.DBus.Protocol')" />
    </ItemGroup>
  </Target>

</Project>
