<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Hycl.Launcher.Core.Plugins;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.PluginWorkshopView"
             x:DataType="p:PluginWorkshopViewModel"
             x:CompileBindings="True">

    <!-- 插件工坊：设置页「插件工坊」分区的管理面板（对照 KAMUCL 设置页功能与插件分类） -->
    <StackPanel Spacing="10">

        <!-- 下载源：官方源 / 自定义源选择 + 安全提示 -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="9">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="下载源" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="190" SelectedIndex="{Binding SelectedSourceIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Hycl 官方仓库源（推荐）" />
                        <ComboBoxItem Content="自定义源" />
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="{Binding ManifestStatusText}"
                               FontSize="12" Foreground="{DynamicResource Gray2Brush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="action-btn" Content="刷新清单" VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
                </Grid>

                <StackPanel Spacing="7" IsVisible="{Binding IsCustomSource}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomSourceUrl, Mode=TwoWay}"
                                 PlaceholderText="https://example.com/hycl-online-manifest.json（留空等同官方源）"
                                 FontSize="12" />
                        <Button Grid.Column="1" Classes="mc-btn primary-soft" Content="应用"
                                Command="{Binding ApplyCustomSourceCommand}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource ErrorDarkBrush}" TextWrapping="Wrap"
                               LineHeight="17"
                               Text="⚠ 安全提示：自定义下载源来自外部，不受 Hycl 官方控制与审核。插件包虽会经 SHA-256 校验安装，但校验值同样来自该源——恶意源可以分发被篡改的插件。请只添加自己完全信任的来源。" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="插件清单源不可达，当前仅显示本机已安装插件。"
                   FontSize="12" Foreground="{DynamicResource ErrorDarkBrush}"
                   IsVisible="{Binding IsManifestOffline}" TextWrapping="Wrap" />

        <!-- 插件安装/更新后需重启生效：主动横幅（立即重启 / 稍后），而不是行内小字 -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PrimaryDeepBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12"
                IsVisible="{Binding IsRestartBannerVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="{Binding RestartBannerText}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="mc-btn primary-soft" Content="立即重启"
                        Command="{Binding RestartNowCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="mc-btn" Content="稍后"
                        Command="{Binding RestartLaterCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:PluginWorkshopRow">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateText}" FontSize="11.5"
                                               Foreground="{DynamicResource Gray3Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="需重启启动器" FontSize="11"
                                               Foreground="{DynamicResource ErrorDarkBrush}" VerticalAlignment="Center"
                                               IsVisible="{Binding RestartRequired}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="12"
                                           Foreground="{DynamicResource Gray2Brush}" TextWrapping="Wrap"
                                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}"
                                             Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource PrimaryDeepBrush}"
                                             IsVisible="{Binding IsInstalling}" />
                                <!-- 加载失败时明确显示原因：否则用户只会看到「已启用」但工具页没有入口 -->
                                <TextBlock Text="{Binding LoadErrorText}" FontSize="11.5"
                                           Foreground="{DynamicResource ErrorDarkBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowRetryButton}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="mc-btn primary-soft" Content="重试加载"
                                        Command="{Binding $parent[UserControl].((p:PluginWorkshopViewModel)DataContext).RetryLoadCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowRetryButton}" />
                                <Button Classes="mc-btn" Content="启用"
                                        Command="{Binding $parent[UserControl].((p:PluginWorkshopViewModel)DataContext).EnableCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding !IsEnabled}"
                                        IsEnabled="{Binding IsInstalled}" />
                                <Button Classes="mc-btn danger" Content="禁用"
                                        Command="{Binding $parent[UserControl].((p:PluginWorkshopViewModel)DataContext).DisableCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsEnabled}"
                                        IsEnabled="{Binding IsInstalled}" />
                                <Button Classes="mc-btn" Content="{Binding ButtonText}"
                                        Command="{Binding $parent[UserControl].((p:PluginWorkshopViewModel)DataContext).InstallCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowInstallButton}"
                                        IsEnabled="{Binding !IsInstalling}" />
                                <!-- 取消保留断点：短时间内再次点「安装」会从中断处继续 -->
                                <Button Classes="mc-btn" Content="取消"
                                        Command="{Binding $parent[UserControl].((p:PluginWorkshopViewModel)DataContext).InstallCancelCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsInstalling}" />
                                <Button Classes="mc-btn danger" Content="卸载"
                                        Command="{Binding $parent[UserControl].((p:PluginWorkshopViewModel)DataContext).UninstallCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowUninstallButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock FontSize="11.5" Foreground="{DynamicResource Gray3Brush}" TextWrapping="Wrap"
                   Text="插件包由 Hycl-online 仓库分发，下载后经 SHA-256 校验安装。新装插件默认启用；启用的插件会出现在工具页，点进去可打开该插件的功能设置页。更新已加载的插件需重启启动器，卸载会同时移除工具页入口。" />
    </StackPanel>
</UserControl>
