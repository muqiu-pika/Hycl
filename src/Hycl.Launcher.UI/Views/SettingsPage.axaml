<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:m="clr-namespace:Hycl.Launcher.Core.Models;assembly=Hycl.Launcher.Core"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             x:CompileBindings="True">

    <!-- 对应网页版 SettingsView：左侧分区导航 + 右侧数据驱动的设置卡片 -->
    <Grid ColumnDefinitions="186,*">
        <Border Classes="page-divider">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Margin="14,8,14,12" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:NavGroupViewModel">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Classes="side-cat" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:NavItemViewModel">
                                            <Button Classes="side-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).SelectSectionCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <c:HyclIcon Kind="{Binding IconKey}"
                                                                Width="16"
                                                                Height="16"
                                                                Margin="0,0,9,0"
                                                                VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 右侧：加载期间显示弹跳图标，数据就绪后再显示设置内容 -->
        <Panel Grid.Column="1" Margin="22,18,18,18">
            <ScrollViewer IsVisible="{Binding IsReady}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Classes="page-heading" Text="{Binding SelectedSection.Title}" />
                    <StackPanel Spacing="12" IsVisible="{Binding CurrentSection, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ItemsControl ItemsSource="{Binding CurrentSection.Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:SettingCardViewModel">
                                    <Border Background="{DynamicResource GlassSurfaceBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="16,14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.DataTemplates>
                                                    <DataTemplate x:DataType="m:ComboRowViewModel">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                                <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                                <ComboBox Grid.Column="1"
                                                                          Width="190"
                                                                          HorizontalAlignment="Right"
                                                                          ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Border Classes="srow-divider" Margin="0,10,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:ToggleRowViewModel">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                                <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                                <ToggleSwitch Grid.Column="1"
                                                                              OnContent=""
                                                                              OffContent=""
                                                                              IsChecked="{Binding IsOn, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Border Classes="srow-divider" Margin="0,10,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:TextRowViewModel">
                                                        <StackPanel>
                                                            <TextBlock Classes="srow-label" Text="{Binding Label}" Margin="0,8,0,4" />
                                                            <TextBox Classes="stext"
                                                                     Text="{Binding Text, Mode=TwoWay}"
                                                                     PlaceholderText="{Binding Placeholder}" />
                                                            <Border Classes="srow-divider" Margin="0,10,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:InfoRowViewModel">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                                <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Classes="srow-value"
                                                                           Text="{Binding Value}"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="360"
                                                                           TextAlignment="Right" />
                                                            </Grid>
                                                            <Border Classes="srow-divider" Margin="0,10,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:MutableInfoRowViewModel">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                                <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Classes="srow-value"
                                                                           Text="{Binding Value}"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="360"
                                                                           TextAlignment="Right" />
                                                            </Grid>
                                                            <Border Classes="srow-divider" Margin="0,10,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:TextLineRowViewModel">
                                                        <StackPanel>
                                                            <TextBlock Classes="sline" Text="{Binding Text}" />
                                                            <Border Classes="srow-divider" Margin="0,10,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:LogRowViewModel">
                                                        <Border Classes="slog" Margin="0,8,0,0">
                                                            <SelectableTextBlock Text="{Binding Text}"
                                                                                 FontFamily="Consolas,monospace"
                                                                                 FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:ButtonsRowViewModel">
                                                        <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="m:SettingButtonViewModel">
                                                                    <Button Classes="mc-btn"
                                                                            Classes.primary="{Binding IsPrimary}"
                                                                            Command="{Binding Command}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <c:HyclIcon Kind="{Binding IconKey}"
                                                                                        Width="15"
                                                                                        Height="15"
                                                                                        VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       FontSize="13"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.DataTemplates>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <c:McLoading Text="正在加载设置…"
                         IconSize="48"
                         Foreground="{DynamicResource Gray2Brush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsLoading}" />
        </Panel>
    </Grid>
</UserControl>
