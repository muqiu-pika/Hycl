<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:m="clr-namespace:Hycl.Launcher.Core.Models;assembly=Hycl.Launcher.Core"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             x:CompileBindings="True">

    <!-- 对应网页版 SettingsView：左侧分区导航 + 右侧数据驱动的设置卡片 -->
    <Grid ColumnDefinitions="186,*">
        <Border Classes="page-divider">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Margin="14,8,14,12" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:NavGroupViewModel">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Classes="side-cat" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:NavItemViewModel">
                                            <Button Classes="side-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).SelectSectionCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <c:HyclIcon Kind="{Binding IconKey}"
                                                                Width="16"
                                                                Height="16"
                                                                Margin="0,0,9,0"
                                                                VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 右侧：加载期间显示弹跳图标，数据就绪后再显示设置内容 -->
        <Panel Grid.Column="1" Margin="22,18,18,18">
            <ScrollViewer IsVisible="{Binding IsReady}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Classes="page-heading" Text="{Binding SelectedSection.Title}" />
                    <StackPanel IsVisible="{Binding CurrentSection, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ItemsControl ItemsSource="{Binding CurrentSection.Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:SettingCardViewModel">
                                    <Border Classes="setting-card" Margin="0,0,0,14">
                                        <StackPanel>
                                            <!-- 卡片标题层级（对应 PCL-CE MyCard 标题） -->
                                            <TextBlock Classes="setting-card-title" Text="{Binding Title}" />
                                            <Border Classes="setting-card-rule" />
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.DataTemplates>
                                                    <DataTemplate x:DataType="m:ComboRowViewModel">
                                                        <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                                            <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                            <c:McComboBox Grid.Column="1"
                                                                          Width="210"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"
                                                                          Items="{Binding Options}"
                                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:ToggleRowViewModel">
                                                        <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                                            <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                            <ToggleSwitch Grid.Column="1"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"
                                                                          OnContent=""
                                                                          OffContent=""
                                                                          IsChecked="{Binding IsOn, Mode=TwoWay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:TextRowViewModel">
                                                        <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                                            <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                            <TextBox Grid.Column="1"
                                                                     Classes="stext"
                                                                     HorizontalAlignment="Stretch"
                                                                     VerticalAlignment="Center"
                                                                     Text="{Binding Text, Mode=TwoWay}"
                                                                     PlaceholderText="{Binding Placeholder}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:InfoRowViewModel">
                                                        <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                                            <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Classes="srow-value"
                                                                       MaxWidth="420"
                                                                       HorizontalAlignment="Right"
                                                                       Text="{Binding Value}"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:MutableInfoRowViewModel">
                                                        <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                                            <TextBlock Classes="srow-label" Text="{Binding Label}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Classes="srow-value"
                                                                       MaxWidth="420"
                                                                       HorizontalAlignment="Right"
                                                                       Text="{Binding Value}"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:TextLineRowViewModel">
                                                        <!-- 说明文字：整行铺满，不套 44px 行高，避免挤占纵向空间 -->
                                                        <TextBlock Classes="sline"
                                                                   Text="{Binding Text}"
                                                                   Margin="0,0,0,10" />
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:LogRowViewModel">
                                                        <Border Classes="slog" Margin="0,4,0,8">
                                                            <SelectableTextBlock Text="{Binding Text}"
                                                                                 FontFamily="Consolas,monospace"
                                                                                 FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                    <DataTemplate x:DataType="m:ButtonsRowViewModel">
                                                        <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,4,0,2">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <!-- 小窗口下按钮自动换行，不撑出横向滚动条 -->
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="m:SettingButtonViewModel">
                                                                    <Button Classes="mc-btn"
                                                                            Margin="0,0,8,6"
                                                                            Classes.primary="{Binding IsPrimary}"
                                                                            Command="{Binding Command}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <c:HyclIcon Kind="{Binding IconKey}"
                                                                                        Width="15"
                                                                                        Height="15"
                                                                                        VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       FontSize="13"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.DataTemplates>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <c:McLoading Text="正在加载设置…"
                         IconSize="48"
                         Foreground="{DynamicResource Gray2Brush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsLoading}" />
        </Panel>
    </Grid>
</UserControl>
