<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:m="clr-namespace:Hycl.Launcher.Core.Models;assembly=Hycl.Launcher.Core"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.DownloadPage"
             x:DataType="vm:DownloadPageViewModel"
             x:CompileBindings="True">

    <!-- 对应 PCL-CE 的 PageDownloadInstall：安装新版本 → 选游戏版本 → 选需要安装的内容 → 命名安装 -->
    <UserControl.Styles>
        <!-- 页面级纵向滚动条向启动器右缘靠 12px（内容边距本就留白，文字位置不动，
             落点距窗口右缘约 6px，不越出圆角窗形范围） -->
        <Style Selector="ScrollViewer.page-scroll /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Margin" Value="0,0,-12,0" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="186,*">

        <!-- ── 左侧导航 ─────────────────────────────────────── -->
        <Border Classes="page-divider">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Margin="14,8,14,12" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:NavGroupViewModel">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Classes="side-cat"
                                           Text="{Binding Title}"
                                           IsVisible="{Binding HasTitle}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:NavItemViewModel">
                                            <Button Classes="side-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).SelectSectionCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <c:BlockIcon Kind="{Binding IconKey}"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,9,0"
                                                                 VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Panel Grid.Column="1" Margin="22,18,18,0">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- ── 标题与工具行 ─────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="{Binding SelectedSection.Title}"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="mc-btn"
                            Padding="9,4"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="刷新版本列表">
                        <c:HyclIcon Kind="refresh" Width="15" Height="15" />
                    </Button>
                </Grid>

                <!-- ── 安装向导 ────────────────────────────────── -->
                <Panel Grid.Row="1" Margin="0,0,0,12" IsVisible="{Binding IsInstallSection}">

                    <!-- 步骤 1：选择游戏版本 -->
                    <ScrollViewer IsVisible="{Binding Wizard.IsStep1}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Panel>
                            <c:McLoading Width="120"
                                         Height="80"
                                         Text="正在获取版本列表"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding Wizard.IsMcListLoading}" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Wizard.McListError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <c:HyclIcon Kind="info"
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource ErrorBrush}" />
                                <TextBlock Classes="dl-empty" Text="{Binding Wizard.McListError}" />
                                <Button Classes="mc-btn"
                                        Content="重试"
                                        HorizontalAlignment="Center"
                                        Command="{Binding RefreshCommand}" />
                            </StackPanel>

                            <!-- 版本分组卡片（PCL-CE：默认折叠、展开才渲染条目） -->
                            <ItemsControl Margin="0,2,8,8" ItemsSource="{Binding Wizard.McGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VersionGroupViewModel">
                                        <Border Background="{DynamicResource GlassSurfaceBrush}"
                                                BorderBrush="{DynamicResource SoftLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6,6"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Button Classes="ver-row"
                                                        Command="{Binding ToggleCommand}">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CountText}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Gray3Brush}" />
                                                        <c:HyclIcon Grid.Column="2"
                                                                    Width="14"
                                                                    Height="14"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Gray2Brush}"
                                                                    Kind="chevron-down"
                                                                    IsVisible="{Binding IsExpanded}" />
                                                        <c:HyclIcon Grid.Column="2"
                                                                    Width="14"
                                                                    Height="14"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Gray2Brush}"
                                                                    Kind="chevron-right"
                                                                    IsVisible="{Binding !IsExpanded}" />
                                                    </Grid>
                                                </Button>
                                                <ItemsControl Margin="2,4,0,2" ItemsSource="{Binding VisibleItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:VersionItemViewModel">
                                                            <Button Classes="ver-row"
                                                                    Classes.selected="{Binding IsSelected}"
                                                                    Width="246"
                                                                    Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).Wizard.SelectMcCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                    <c:BlockIcon Kind="{Binding IconKey}"
                                                                                 Width="24"
                                                                                 Height="24"
                                                                                 VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource TextBrush}" />
                                                                        <TextBlock Text="{Binding Info}"
                                                                                   FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource Gray3Brush}" />
                                                                    </StackPanel>
                                                                    <c:HyclIcon Grid.Column="2"
                                                                                Width="14"
                                                                                Height="14"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource PrimaryBrush}"
                                                                                Kind="chevron-right" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </ScrollViewer>

                    <!-- 步骤 2：选择需要安装的内容 -->
                    <Panel IsVisible="{Binding Wizard.IsStep2}">

                        <!-- 页 A：加载器卡片 + 前置 Mod（对应 PCL-CE 的 PanSelect） -->
                        <ScrollViewer IsVisible="{Binding !Wizard.IsLoaderPage}"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0" Spacing="9">

                                <!-- 顶卡：返回 + 版本图标 + 实例名输入 -->
                                <Border Background="{DynamicResource GlassSurfaceBrush}"
                                        BorderBrush="{DynamicResource SoftLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,9">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                            <Button Classes="back-btn"
                                                    MinHeight="0"
                                                    Margin="0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding Wizard.BackToMcListCommand}">
                                                <c:HyclIcon Kind="chevron-left" Width="15" Height="15" />
                                            </Button>
                                            <c:BlockIcon Grid.Column="1"
                                                         Kind="grass-block"
                                                         Width="30"
                                                         Height="30"
                                                         VerticalAlignment="Center" />
                                            <TextBox Grid.Column="2"
                                                     MinHeight="30"
                                                     Padding="2,3"
                                                     FontSize="14"
                                                     MaxLength="70"
                                                     VerticalAlignment="Center"
                                                     PlaceholderText="版本名称"
                                                     Text="{Binding Wizard.TargetName, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="3"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Gray2Brush}">
                                                <Run Text="{Binding Wizard.SelectedLoaderName}" />
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock FontSize="12.5"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding Wizard.TargetNameError}"
                                                   IsVisible="{Binding Wizard.TargetNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>

                                <Panel>
                                    <!-- 卡片常显：每个加载器右侧独立展示状态字（获取配置中/可下载/暂无对应资源/配置获取失败，请刷新重试/与 X 冲突），对应 PCL-CE -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="dl-empty"
                                                   IsVisible="{Binding Wizard.LoaderError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Text="{Binding Wizard.LoaderError}" />
                                        <ItemsControl ItemsSource="{Binding Wizard.LoaderCards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LoaderCardViewModel">
                                                    <Border Background="{DynamicResource GlassSurfaceBrush}"
                                                            BorderBrush="{DynamicResource SoftLineBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12,9"
                                                            Margin="0,0,0,2">
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Cursor="Hand"
                                                                Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).Wizard.OpenLoaderCardCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                                <c:BlockIcon Kind="{Binding IconKey}"
                                                                             Width="22"
                                                                             Height="22"
                                                                             VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="13.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="{Binding Description}"
                                                                               FontSize="11.5"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource Gray3Brush}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Classes="card-status"
                                                                           Classes.dark="{Binding IsStatusDark}"
                                                                           Text="{Binding StatusText}" />
                                                                <StackPanel Grid.Column="3"
                                                                            Orientation="Horizontal"
                                                                            Spacing="6"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding HasSelection}">
                                                                    <TextBlock Text="{Binding SelectedTitle}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource PrimaryDeepBrush}" />
                                                                    <Button Classes="mc-btn danger"
                                                                            MinHeight="0"
                                                                            Height="22"
                                                                            Padding="6,0"
                                                                            FontSize="11"
                                                                            Content="取消选择"
                                                                            Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).Wizard.ClearCardSelectionCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                                <c:HyclIcon Grid.Column="4"
                                                                            Width="14"
                                                                            Height="14"
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{DynamicResource Gray2Brush}"
                                                                            Kind="chevron-right" />
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="sline"
                                                   Margin="2,4,0,0"
                                                   Text="点击加载器进入版本选择；不选择任何加载器则安装原版。" />

                                <!-- 附属安装包卡片（OptiFine / LiteLoader / 前置 Mod；按互斥规则显示） -->
                                <ItemsControl ItemsSource="{Binding Wizard.CompanionCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LoaderCardViewModel">
                                            <Border Background="{DynamicResource GlassSurfaceBrush}"
                                                    BorderBrush="{DynamicResource SoftLineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,9"
                                                    Margin="0,0,0,2"
                                                    IsVisible="{Binding IsAvailable}">
                                                <StackPanel>
                                                    <Button Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Cursor="Hand"
                                                            Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).Wizard.OpenLoaderCardCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                            <c:BlockIcon Kind="{Binding IconKey}"
                                                                         Width="22"
                                                                         Height="22"
                                                                         VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="13.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="11.5"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource Gray3Brush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="6"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding HasSelection}">
                                                                <TextBlock Text="{Binding SelectedTitle}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource PrimaryDeepBrush}" />
                                                                <Button Classes="mc-btn danger"
                                                                        MinHeight="0"
                                                                        Height="22"
                                                                        Padding="6,0"
                                                                        FontSize="11"
                                                                        Content="取消选择"
                                                                        Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).Wizard.ClearCompanionCardCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="未选择"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Gray3Brush}"
                                                                       IsVisible="{Binding !HasSelection}" />
                                                            <c:HyclIcon Grid.Column="3"
                                                                        Width="14"
                                                                        Height="14"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource Gray2Brush}"
                                                                        Kind="chevron-right" />
                                                        </Grid>
                                                    </Button>
                                                    <!-- 点击整卡进入独立选择页，不再就地展开 -->
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 附件缺失提示（对应 PCL-CE ShowHint*） -->
                                <TextBlock Margin="2,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Text="未选择安装 Fabric API，这可能导致大多数 Fabric 模组无法启动。"
                                           IsVisible="{Binding Wizard.ShowFabricApiWarning}" />
                                <TextBlock Margin="2,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Text="未选择安装 Legacy Fabric API，这可能导致大多数 Legacy Fabric 模组无法启动。"
                                           IsVisible="{Binding Wizard.ShowLegacyFabricApiWarning}" />
                                <TextBlock Margin="2,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Text="必须安装 OptiFabric 才能使 OptiFine 与 Fabric 兼容。"
                                           IsVisible="{Binding Wizard.ShowOptiFabricWarning}" />
                                <TextBlock Margin="2,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryDeepBrush}"
                                           Text="Legacy Fabric 需要手动安装 LegacyOptiFabric 才能与 OptiFine 兼容。"
                                           IsVisible="{Binding Wizard.ShowLegacyOptiFabricWarning}" />
                                </StackPanel>
                            </Panel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 页 B：加载器版本选择页（选完自动返回，对应 PCL-CE 的交互） -->
                        <Grid IsVisible="{Binding Wizard.IsLoaderPage}" RowDefinitions="Auto,*">
                            <Button Grid.Row="0"
                                    Classes="back-btn"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Wizard.BackToLoaderCardsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <c:HyclIcon Kind="chevron-left"
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Margin="0,1,0,0" />
                                    <TextBlock Text="返回上一步" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,4,8,0">
                                <StackPanel Spacing="8">
                                    <Border Background="{DynamicResource GlassSurfaceBrush}"
                                            BorderBrush="{DynamicResource SoftLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,9">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <c:BlockIcon Kind="{Binding Wizard.ActiveLoaderCard.IconKey}"
                                                         Width="24"
                                                         Height="24"
                                                         VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Wizard.ActiveLoaderCard.Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Wizard.ActiveLoaderCard.Description}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Gray3Brush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Gray3Brush}"
                                                       Text="{Binding Wizard.ActiveLoaderCard.CountText}" />
                                        </Grid>
                                    </Border>

                                    <!-- 附属卡（Fabric API / LiteLoader / OptiFine）选择页的取消入口：清空已选并返回 -->
                                    <Button Classes="mc-btn danger"
                                            HorizontalAlignment="Right"
                                            Content="取消选择"
                                            IsVisible="{Binding Wizard.ActiveLoaderCard.IsAccessory}"
                                            Command="{Binding Wizard.CancelCompanionSelectionCommand}" />

                                    <Border Background="{DynamicResource GlassSurfaceBrush}"
                                            BorderBrush="{DynamicResource SoftLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,6">
                                        <StackPanel>
                                            <c:McLoading Width="60"
                                                         Height="50"
                                                         IconSize="26"
                                                         Text="获取配置中"
                                                         IsVisible="{Binding Wizard.ActiveLoaderCard.IsLoading}"
                                                         HorizontalAlignment="Center" />
                                            <!-- 网络失败（超时/连接被拒/HTTP 错误/解析失败）：提示 + 可刷新重试 -->
                                            <StackPanel Margin="4,6"
                                                        Spacing="7"
                                                        HorizontalAlignment="Center"
                                                        IsVisible="{Binding Wizard.ActiveLoaderCard.ShowRetryButton}">
                                                <TextBlock FontSize="12"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource ErrorBrush}"
                                                           Text="配置获取失败，请刷新重试" />
                                                <Button Classes="mc-btn"
                                                        MinHeight="0"
                                                        Padding="10,4"
                                                        FontSize="12"
                                                        Content="刷新重试"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding Wizard.RetryLoaderCardCommand}"
                                                        CommandParameter="{Binding Wizard.ActiveLoaderCard}" />
                                            </StackPanel>
                                            <!-- 请求成功但没有对应资源（不是网络失败） -->
                                            <TextBlock FontSize="12"
                                                       Margin="4,8"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Gray2Brush}"
                                                       Text="暂无对应资源"
                                                       IsVisible="{Binding Wizard.ActiveLoaderCard.ShowEmptyState}" />
                                            <ItemsControl ItemsSource="{Binding Wizard.ActiveLoaderCard.Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:VersionItemViewModel">
                                                        <Button Classes="ver-row"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).Wizard.SelectLoaderItemCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="{Binding Info}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource Gray3Brush}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <ItemsControl ItemsSource="{Binding Tags}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Classes="tag">
                                                                                    <TextBlock Text="{Binding}" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <c:HyclIcon Width="14"
                                                                                Height="14"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource PrimaryBrush}"
                                                                                Kind="check"
                                                                                IsVisible="{Binding IsSelected}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Panel>
                </Panel>

                <!-- ── 社区资源分区（整合包 / 模组 / 资源包 / 光影） ── -->
                <Panel Grid.Row="1" Margin="0,0,0,12" IsVisible="{Binding IsCompSection}">
                    <ScrollViewer Classes="page-scroll" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,8,0" Spacing="8">
                            <!-- ═══ 列表页：搜索 + 结果 + 分页 ═══ -->
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding ActiveCompSection.SelectedProject, Converter={x:Static ObjectConverters.IsNull}}">
                                <TextBlock Classes="sline"
                                           Margin="2,0,0,0"
                                           Text="{Binding ActiveCompSection.Description}" />

                                <!-- 搜索卡（对应 PCL-CE PageComp 筛选卡） -->
                                <Border Background="{DynamicResource GlassSurfaceBrush}"
                                        BorderBrush="{DynamicResource SoftLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,9">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox PlaceholderText="搜索社区资源…"
                                                     Text="{Binding ActiveCompSection.SearchText, Mode=TwoWay}" />
                                            <Button Grid.Column="1"
                                                    Classes="mc-btn line-btn"
                                                    Command="{Binding ActiveCompSection.SearchFromStartCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <c:HyclIcon Kind="search" Width="14" Height="14" />
                                                    <TextBlock Text="搜索" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <!-- 筛选项全部来自固定全集（版本全集+本机实例、分类全集、加载器、排序），
                                             与搜索结果无关；窄窗口时由 WrapPanel 换行，外层可纵向滚动 -->
                                        <WrapPanel>
                                            <c:McComboBox MinWidth="150" Margin="0,0,8,8"
                                                          ToolTip.Tip="游戏版本"
                                                          Items="{Binding ActiveCompSection.GameVersionOptions}"
                                                          SelectedItem="{Binding ActiveCompSection.SelectedGameVersion, Mode=TwoWay}" />
                                            <c:McComboBox MinWidth="140" Margin="0,0,8,8"
                                                          ToolTip.Tip="分类"
                                                          Items="{Binding ActiveCompSection.CategoryOptions}"
                                                          SelectedItem="{Binding ActiveCompSection.SelectedCategory, Mode=TwoWay}" />
                                            <c:McComboBox MinWidth="130" Margin="0,0,8,8"
                                                          ToolTip.Tip="加载器"
                                                          IsVisible="{Binding ActiveCompSection.SupportsLoaderFilter}"
                                                          Items="{Binding ActiveCompSection.LoaderOptions}"
                                                          SelectedItem="{Binding ActiveCompSection.SelectedLoader, Mode=TwoWay}" />
                                            <c:McComboBox MinWidth="130" Margin="0,0,8,8"
                                                          ToolTip.Tip="排序"
                                                          Items="{x:Static vm:CompSectionViewModel.SortOptions}"
                                                          SelectedItem="{Binding ActiveCompSection.SelectedSort, Mode=TwoWay}" />
                                            <TextBlock Classes="sline"
                                                       Margin="0,0,0,8"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ActiveCompSection.ResultSummary}" />
                                        </WrapPanel>
                                        <TextBlock Classes="sline"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding ActiveCompSection.ErrorText}"
                                                   IsVisible="{Binding ActiveCompSection.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <c:McLoading Width="120"
                                                     Height="70"
                                                     Text="正在搜索"
                                                     HorizontalAlignment="Center"
                                                     IsVisible="{Binding ActiveCompSection.IsSearching}" />
                                    </StackPanel>
                                </Border>

                                <!-- 搜索结果（项目卡片，点击进入详情） -->
                                <ItemsControl ItemsSource="{Binding ActiveCompSection.Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CompProjectItemViewModel">
                                            <Button Classes="ver-row comp-row"
                                                    Margin="0,0,0,2"
                                                    Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).ActiveCompSection.SelectProjectCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="查看详情并选择版本下载">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <!-- 资源缩略图（对应 PCL-CE MyCompItem 的 50x50 圆角 Logo，占位由灰底承担） -->
                                                    <Border Width="42"
                                                            Height="42"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource Primary8Brush}"
                                                            VerticalAlignment="Center">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,42,42" RadiusX="6" RadiusY="6" />
                                                        </Border.Clip>
                                                        <c:HyclImage Url="{Binding IconUrl}"
                                                                     Width="42"
                                                                     Height="42"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}" />
                                                            <Border Classes="tag">
                                                                <TextBlock Text="{Binding SourceText}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Gray3Brush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="tag">
                                                                            <TextBlock Text="{Binding}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding DownloadText}"
                                                                       FontSize="10.5"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Gray3Brush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <c:HyclIcon Grid.Column="2"
                                                                Width="14"
                                                                Height="14"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Gray2Brush}"
                                                                Kind="chevron-right" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 分页 -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="10"
                                            IsVisible="{Binding ActiveCompSection.Results.Count}">
                                    <Button Classes="mc-btn"
                                            MinHeight="0"
                                            Height="26"
                                            Content="上一页"
                                            IsEnabled="{Binding ActiveCompSection.CanGoPrevious}"
                                            Command="{Binding ActiveCompSection.GoPreviousPageCommand}" />
                                    <Button Classes="mc-btn"
                                            MinHeight="0"
                                            Height="26"
                                            Content="下一页"
                                            IsEnabled="{Binding ActiveCompSection.CanGoNext}"
                                            Command="{Binding ActiveCompSection.GoNextPageCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- ═══ 详情页：项目信息 + 文件版本 + 下载 ═══ -->
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding ActiveCompSection.SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <!-- 顶卡：返回 + 图标 + 标题/作者/来源 -->
                                <Border Background="{DynamicResource GlassSurfaceBrush}"
                                        BorderBrush="{DynamicResource SoftLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Button Classes="line-btn"
                                                MinHeight="0"
                                                Height="30"
                                                Padding="9,4"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="返回搜索结果"
                                                Command="{Binding ActiveCompSection.CloseDetailCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <c:HyclIcon Kind="chevron-left"
                                                            Width="13"
                                                            Height="13"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource BlockButtonTextBrush}" />
                                                <TextBlock Text="返回"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Border Grid.Column="1"
                                                Width="52"
                                                Height="52"
                                                CornerRadius="8"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Primary8Brush}">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,52,52" RadiusX="8" RadiusY="8" />
                                            </Border.Clip>
                                            <c:HyclImage Url="{Binding ActiveCompSection.SelectedProject.IconUrl}"
                                                         Width="52"
                                                         Height="52"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding ActiveCompSection.SelectedProject.Title}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="作者："
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Gray3Brush}" />
                                                <TextBlock Text="{Binding ActiveCompSection.SelectedProjectAuthor}"
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Gray3Brush}" />
                                                <Border Classes="tag">
                                                    <TextBlock Text="{Binding ActiveCompSection.SelectedProject.SourceText}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <c:McComboBox Width="132"
                                                          Height="30"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="收藏到哪个收藏夹"
                                                          Items="{Binding ActiveCompSection.FavoriteFolderNames}"
                                                          SelectedItem="{Binding ActiveCompSection.SelectedFavoriteFolder, Mode=TwoWay}" />
                                            <Button Classes="mc-btn"
                                                    MinHeight="0"
                                                    Height="30"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="收藏到所选收藏夹（离线可查看）"
                                                    Command="{Binding ActiveCompSection.ToggleFavoriteCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <c:HyclIcon Kind="star"
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource PrimaryDeepBrush}" />
                                                    <TextBlock Text="{Binding ActiveCompSection.FavoriteActionText}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryDeepBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="line-btn"
                                                    MinHeight="0"
                                                    Height="30"
                                                    Padding="9,4"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="新建收藏夹"
                                                    Content="新建夹"
                                                    Command="{Binding ActiveCompSection.BeginCreateFavoriteFolderCommand}" />
                                        </StackPanel>
                                        <c:McLoading Grid.Column="4"
                                                     Width="56"
                                                     Height="46"
                                                     IconSize="24"
                                                     HorizontalAlignment="Right"
                                                     IsVisible="{Binding ActiveCompSection.IsLoadingVersions}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0"
                                          ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="8"
                                          IsVisible="{Binding ActiveCompSection.IsNewFavoriteFolderVisible}">
                                        <TextBlock Text="收藏夹名称"
                                                   Classes="sline"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Height="30"
                                                 PlaceholderText="例如：常用模组"
                                                 Text="{Binding ActiveCompSection.NewFavoriteFolderName, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Classes="mc-btn"
                                                MinHeight="0"
                                                Height="30"
                                                Padding="12,4"
                                                Content="新建"
                                                Command="{Binding ActiveCompSection.ConfirmCreateFavoriteFolderCommand}" />
                                        <Button Grid.Column="3"
                                                Classes="line-btn"
                                                MinHeight="0"
                                                Height="30"
                                                Padding="10,4"
                                                Content="取消"
                                                Command="{Binding ActiveCompSection.CancelCreateFavoriteFolderCommand}" />
                                    </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 信息卡：分类 / 更新时间 / 下载量 / 支持版本 / 加载器 -->
                                <Border Background="{DynamicResource GlassSurfaceBrush}"
                                        BorderBrush="{DynamicResource SoftLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,9">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="72,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="6"
                                              RowSpacing="6">
                                            <TextBlock Text="分类" Classes="sline" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ActiveCompSection.SelectedProjectCategoryText}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Grid.Row="1" Text="更新时间" Classes="sline" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding ActiveCompSection.SelectedProjectUpdateText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Grid.Row="2" Text="下载量" Classes="sline" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="1"
                                                       Text="{Binding ActiveCompSection.SelectedProjectDownloadText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Grid.Row="3" Text="支持版本" Classes="sline" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Text="{Binding ActiveCompSection.SelectedProjectGameVersionText}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Grid.Row="4" Text="加载器" Classes="sline" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Text="{Binding ActiveCompSection.SelectedProjectLoaderText}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ActiveCompSection.SelectedProjectDescription}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Gray3Brush}" />
                                    </StackPanel>
                                </Border>

                                <!-- 下载状态：进度 + 失败原因 -->
                                <Border Background="{DynamicResource Primary8Brush}"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        IsVisible="{Binding ActiveCompSection.IsDownloading}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding ActiveCompSection.DownloadStateText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource PrimaryDeepBrush}" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="4"
                                                     Value="{Binding ActiveCompSection.DownloadPercent}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Text="{Binding ActiveCompSection.DownloadErrorText}"
                                           IsVisible="{Binding ActiveCompSection.DownloadErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <!-- 文件 / 版本列表 -->
                                <Border Background="{DynamicResource GlassSurfaceBrush}"
                                        BorderBrush="{DynamicResource SoftLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,9">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="文件 / 版本列表"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Classes="sline"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding ActiveCompSection.VersionErrorText}"
                                                   IsVisible="{Binding ActiveCompSection.VersionErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                        <!-- 详情页筛选：选项来自本资源文件出现过的 MC 版本/加载器（PCL-CE 同） -->
                                        <WrapPanel IsVisible="{Binding ActiveCompSection.HasDetailVersionFilter}">
                                            <c:McComboBox MinWidth="124"
                                                          Margin="0,0,8,4"
                                                          ToolTip.Tip="按 Minecraft 版本筛选"
                                                          Items="{Binding ActiveCompSection.DetailVersionOptions}"
                                                          SelectedItem="{Binding ActiveCompSection.SelectedDetailVersion, Mode=TwoWay}" />
                                            <c:McComboBox MinWidth="112"
                                                          Margin="0,0,8,4"
                                                          ToolTip.Tip="按加载器筛选"
                                                          IsVisible="{Binding ActiveCompSection.HasDetailLoaderFilter}"
                                                          Items="{Binding ActiveCompSection.DetailLoaderOptions}"
                                                          SelectedItem="{Binding ActiveCompSection.SelectedDetailLoader, Mode=TwoWay}" />
                                        </WrapPanel>

                                        <ItemsControl ItemsSource="{Binding ActiveCompSection.VersionFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompFileItemViewModel">
                                                    <Button Classes="ver-row"
                                                            Margin="0,0,0,2"
                                                            ToolTip.Tip="下载该版本"
                                                            Command="{Binding InstallCommand}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource TextBrush}" />
                                                                    <Border Classes="tag">
                                                                        <TextBlock Text="{Binding StatusText}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding GameVersionText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Gray3Brush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                <TextBlock Text="下载中…"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource PrimaryDeepBrush}"
                                                                           IsVisible="{Binding IsInstalling}" />
                                                                <TextBlock Text="{Binding DateText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Gray3Brush}" />
                                                                <TextBlock Text="{Binding SizeText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Gray3Brush}" />
                                                                <c:HyclIcon Width="14"
                                                                            Height="14"
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                                            Kind="download" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 筛选后无文件：给出空状态，版本行（安装入口）随之为空 -->
                                        <TextBlock Classes="dl-empty"
                                                   Margin="0,4,0,2"
                                                   HorizontalAlignment="Left"
                                                   Text="{Binding ActiveCompSection.DetailEmptyText}"
                                                   IsVisible="{Binding ActiveCompSection.IsDetailEmpty}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>

                <!-- ── 安装包分区（客户端 / OptiFine / Forge / …） ── -->
                <Panel Grid.Row="1" Margin="0,0,0,12" IsVisible="{Binding ActiveSection, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer Classes="page-scroll" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,8,0" Spacing="8">

                            <TextBlock Classes="sline"
                                       Margin="2,0,0,0"
                                       Text="{Binding ActiveSection.Hint}" />

                            <c:McLoading Width="120"
                                         Height="80"
                                         Text="正在获取版本列表"
                                         HorizontalAlignment="Center"
                                         Margin="0,40,0,0"
                                         IsVisible="{Binding ActiveSection.IsLoading}" />

                            <StackPanel HorizontalAlignment="Center"
                                        Margin="0,36,0,0"
                                        IsVisible="{Binding ActiveSection.IsFailed}">
                                <c:HyclIcon Kind="info"
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource ErrorBrush}" />
                                <TextBlock Classes="dl-empty" Text="{Binding ActiveSection.ErrorText}" />
                                <Button Classes="mc-btn"
                                        Content="重试"
                                        HorizontalAlignment="Center"
                                        Command="{Binding RefreshCommand}" />
                            </StackPanel>

                            <!-- 版本分组卡片：默认折叠、展开才渲染条目 -->
                            <ItemsControl ItemsSource="{Binding ActiveSection.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VersionGroupViewModel">
                                        <Border Background="{DynamicResource GlassSurfaceBrush}"
                                                BorderBrush="{DynamicResource SoftLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6,6"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Button Classes="ver-row"
                                                        Command="{Binding ToggleCommand}">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CountText}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Gray3Brush}" />
                                                        <c:HyclIcon Grid.Column="2"
                                                                    Width="14"
                                                                    Height="14"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Gray2Brush}"
                                                                    Kind="chevron-down"
                                                                    IsVisible="{Binding IsExpanded}" />
                                                        <c:HyclIcon Grid.Column="2"
                                                                    Width="14"
                                                                    Height="14"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Gray2Brush}"
                                                                    Kind="chevron-right"
                                                                    IsVisible="{Binding !IsExpanded}" />
                                                    </Grid>
                                                </Button>

                                                <TextBlock FontSize="12"
                                                           Margin="6,2,4,4"
                                                           Foreground="{DynamicResource ErrorBrush}"
                                                           Text="{Binding ChildErrorText}"
                                                           IsVisible="{Binding ChildErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                                <ItemsControl Margin="2,4,0,2" ItemsSource="{Binding VisibleItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:VersionItemViewModel">
                                                            <Button Classes="ver-row"
                                                                    Classes.selected="{Binding IsSelected}"
                                                                    Width="246"
                                                                    Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).ActivateSectionItemCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="另存为下载">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9">
                                                                    <c:BlockIcon Kind="{Binding IconKey}"
                                                                                 Width="24"
                                                                                 Height="24"
                                                                                 VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource TextBrush}" />
                                                                        <TextBlock Text="{Binding Info}"
                                                                                   FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource Gray3Brush}" />
                                                                    </StackPanel>
                                                                    <ItemsControl Grid.Column="2"
                                                                                  VerticalAlignment="Center"
                                                                                  ItemsSource="{Binding Tags}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Classes="tag">
                                                                                    <TextBlock Text="{Binding}" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <c:HyclIcon Grid.Column="3"
                                                                                Width="14"
                                                                                Height="14"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource PrimaryBrush}"
                                                                                Kind="download" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>

        <!-- ── 收藏夹（本地持久化，离线可用） ── -->
        <Panel Grid.Row="1" Margin="0,0,0,12" IsVisible="{Binding IsFavoritesSection}">
            <ScrollViewer Classes="page-scroll" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,2,8,0" Spacing="8">
                    <Border Background="{DynamicResource GlassSurfaceBrush}"
                            BorderBrush="{DynamicResource SoftLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding ActiveFavoritesSection.Description}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Gray2Brush}" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="收藏夹"
                                           Classes="sline"
                                           VerticalAlignment="Center" />
                                <c:McComboBox Grid.Column="1"
                                              MinWidth="140"
                                              HorizontalAlignment="Left"
                                              Items="{Binding ActiveFavoritesSection.FolderNames}"
                                              SelectedItem="{Binding ActiveFavoritesSection.SelectedFolderName, Mode=TwoWay}" />
                                <Button Grid.Column="2"
                                        Classes="mc-btn"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        Content="新建"
                                        Command="{Binding ActiveFavoritesSection.BeginCreateFolderCommand}" />
                                <Button Grid.Column="3"
                                        Classes="mc-btn"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        Content="改名"
                                        Command="{Binding ActiveFavoritesSection.BeginRenameFolderCommand}" />
                                <Button Grid.Column="4"
                                        Classes="mc-btn danger"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        Content="删除夹"
                                        IsEnabled="{Binding ActiveFavoritesSection.CanDeleteFolder}"
                                        Command="{Binding ActiveFavoritesSection.DeleteFolderCommand}" />
                                <c:McComboBox Grid.Column="5"
                                              MinWidth="100"
                                              Items="{x:Static vm:FavoritesSectionViewModel.FilterOptions}"
                                              SelectedItem="{Binding ActiveFavoritesSection.SelectedFilter, Mode=TwoWay}" />
                                <Button Grid.Column="6"
                                        Classes="mc-btn"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        Content="刷新"
                                        Command="{Binding ActiveFavoritesSection.RefreshCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Gray2Brush}"
                                           Text="{Binding ActiveFavoritesSection.SummaryText}" />
                                <Button Grid.Column="1"
                                        Classes="mc-btn danger"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        IsEnabled="{Binding ActiveFavoritesSection.HasChecked}"
                                        Content="{Binding ActiveFavoritesSection.RemoveCheckedText}"
                                        Command="{Binding ActiveFavoritesSection.RemoveCheckedCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource GlassSurfaceBrush}"
                            BorderBrush="{DynamicResource SoftLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9"
                            IsVisible="{Binding ActiveFavoritesSection.IsFolderDialogVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding ActiveFavoritesSection.FolderDialogTitle}"
                                       Classes="sline"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Height="30"
                                     Text="{Binding ActiveFavoritesSection.FolderDialogText, Mode=TwoWay}" />
                            <Button Grid.Column="2"
                                    Classes="mc-btn"
                                    MinHeight="0"
                                    Padding="12,4"
                                    FontSize="12"
                                    Content="确定"
                                    Command="{Binding ActiveFavoritesSection.CommitFolderDialogCommand}" />
                            <Button Grid.Column="3"
                                    Classes="line-btn"
                                    MinHeight="0"
                                    Padding="10,4"
                                    FontSize="12"
                                    Content="取消"
                                    Command="{Binding ActiveFavoritesSection.CancelFolderDialogCommand}" />
                        </Grid>
                    </Border>

                    <TextBlock IsVisible="{Binding ActiveFavoritesSection.IsEmpty}"
                               Margin="2,18,0,0"
                               MaxWidth="460"
                               HorizontalAlignment="Left"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Gray2Brush}"
                               Text="{Binding ActiveFavoritesSection.EmptyText}" />

                    <ItemsControl IsVisible="{Binding ActiveFavoritesSection.HasItems}"
                                  ItemsSource="{Binding ActiveFavoritesSection.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteItemViewModel">
                                <Border Background="{DynamicResource GlassSurfaceBrush}"
                                        BorderBrush="{DynamicResource SoftLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,4">
                                    <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        <Border Grid.Column="1"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="6"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Primary8Brush}">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,40,40" RadiusX="6" RadiusY="6" />
                                            </Border.Clip>
                                            <c:HyclImage Url="{Binding IconUrl}"
                                                         Width="40"
                                                         Height="40"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <Border Classes="tag">
                                                    <TextBlock Text="{Binding TypeText}" />
                                                </Border>
                                                <Border Classes="tag">
                                                    <TextBlock Text="{Binding SourceText}" />
                                                </Border>
                                                <TextBlock Text="{Binding SavedText}"
                                                           FontSize="10.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Gray3Brush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Gray3Brush}" />
                                            <TextBlock Text="{Binding Author}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Gray3Brush}" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Classes="mc-btn"
                                                MinHeight="0"
                                                Padding="10,4"
                                                FontSize="11.5"
                                                Content="打开"
                                                Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).ActiveFavoritesSection.OpenCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="4"
                                                Classes="mc-btn danger"
                                                MinHeight="0"
                                                Padding="10,4"
                                                FontSize="11.5"
                                                Content="移除"
                                                Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).ActiveFavoritesSection.RemoveCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="备注"
                                                   Classes="sline"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Height="28"
                                                 FontSize="11.5"
                                                 PlaceholderText="给这条收藏加个备注，例如：服务端必备"
                                                 Text="{Binding Note, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Classes="mc-btn"
                                                MinHeight="0"
                                                Height="28"
                                                Padding="10,2"
                                                FontSize="11.5"
                                                Content="保存备注"
                                                Command="{Binding $parent[UserControl].((vm:DownloadPageViewModel)DataContext).ActiveFavoritesSection.SaveNoteCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Panel>


                <!-- ── 底部：开始安装 + 任务条 ──────────────────── -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <!-- 整块任务条是进入下载详情页的点击热区；取消按钮等子控件优先处理自己的点击 -->
                    <Border Classes="task-tap"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            IsVisible="{Binding Install.IsInstalling}"
                            Cursor="Hand"
                            PointerReleased="OnTaskBarPointerReleased">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              RowDefinitions="Auto,6,16,18"
                              ColumnSpacing="12"
                              RowSpacing="6">
                            <c:HyclIcon Grid.RowSpan="2"
                                        Kind="download"
                                        Width="15"
                                        Height="15"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontSize="12.5"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Install.InstallingName}" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding Install.StageText}" />
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource Gray2Brush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Install.StepCounterText}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Install.StepProgressText}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Install.ElapsedText}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Width="42"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource Gray2Brush}"
                                       Text="{Binding Install.OverallProgressPercent, StringFormat={}{0:0}%}" />
                            <Button Grid.Column="3"
                                    Classes="mc-btn danger"
                                    Padding="10,3"
                                    FontSize="12"
                                    Command="{Binding CancelInstallCommand}"
                                    Content="取消" />

                            <ProgressBar Grid.Row="1"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="3"
                                         Value="{Binding Install.OverallProgressPercent}"
                                         Maximum="100"
                                         Height="6" />

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="4"
                                       Height="16"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Gray2Brush}"
                                       Text="{Binding Install.CurrentDetailText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Install.CurrentDetailText}" />

                            <ItemsControl Grid.Row="3"
                                          Grid.ColumnSpan="4"
                                          Height="18"
                                          ClipToBounds="True"
                                          ItemsSource="{Binding Install.Steps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- 固定单行，不换行：步骤增多不会改变任务条高度 -->
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LaunchStepItemViewModel">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    Margin="0,2,14,0">
                                            <TextBlock Classes="step-marker"
                                                       Classes.done="{Binding IsCompleted}"
                                                       Classes.active="{Binding IsActive}"
                                                       Classes.failed="{Binding IsFailed}"
                                                       Text="{Binding Marker}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Classes="step-title"
                                                       Classes.done="{Binding IsCompleted}"
                                                       Classes.active="{Binding IsActive}"
                                                       Classes.failed="{Binding IsFailed}"
                                                       Classes.pending="{Binding IsPending}"
                                                       Text="{Binding Title}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Classes="mc-btn primary"
                            MinWidth="150"
                            IsVisible="{Binding IsStartButtonVisible}"
                            Command="{Binding Wizard.StartInstallCommand}"
                            Content="开始安装" />
                </Grid>
            </Grid>
        </Panel>

        <!-- 下载前选择保存位置（对应 PCL-CE Save_Click / Install_Click）：选择期间不发起下载 -->
        <Panel Grid.ColumnSpan="2"
               IsVisible="{Binding IsSaveDialogVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="3">
            <Border Classes="dialog-card"
                    Width="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Classes="dialog-title" Text="{Binding ActiveCompSection.SaveDialogTitle}" />
                    <TextBlock Classes="dialog-body"
                               Margin="0,9,0,0"
                               Text="{Binding ActiveCompSection.SaveDialogBody}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Gray3Brush}">
                        <Run Text="文件：" />
                        <Run Text="{Binding ActiveCompSection.SaveFileName}" />
                    </TextBlock>

                    <!-- 普通资源：目标实例 + 保存目录 -->
                    <Grid Margin="0,14,0,0"
                          ColumnDefinitions="84,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="8"
                          RowSpacing="10"
                          IsVisible="{Binding ActiveCompSection.IsInstanceSelectable}">
                        <TextBlock Text="目标实例" Classes="sline" VerticalAlignment="Center" />
                        <c:McComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      Items="{Binding ActiveCompSection.TargetInstanceOptions}"
                                      SelectedItem="{Binding ActiveCompSection.SelectedTargetInstance, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Text="保存目录" Classes="sline" VerticalAlignment="Center" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox PlaceholderText="选择要保存到的文件夹"
                                     Text="{Binding ActiveCompSection.SaveDirectory, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Classes="mc-btn"
                                    Content="浏览…"
                                    Command="{Binding ActiveCompSection.BrowseSaveDirectoryCommand}" />
                        </Grid>
                    </Grid>

                    <!-- 整合包：实例名称，安装到 versions 下 -->
                    <Grid Margin="0,14,0,0"
                          ColumnDefinitions="84,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="8"
                          RowSpacing="10"
                          IsVisible="{Binding ActiveCompSection.IsModpackSave}">
                        <TextBlock Text="实例名称" Classes="sline" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ActiveCompSection.InstanceName, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Text="安装到" Classes="sline" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Text="{Binding ActiveCompSection.SaveDirectory}"
                                   Foreground="{DynamicResource Gray2Brush}" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryDeepBrush}"
                               Text="{Binding ActiveCompSection.SaveHint}"
                               IsVisible="{Binding ActiveCompSection.SaveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Classes="mc-btn"
                                MinWidth="88"
                                Content="取消"
                                Command="{Binding ActiveCompSection.CancelSaveDialogCommand}" />
                        <Button Classes="mc-btn primary"
                                MinWidth="104"
                                Content="{Binding ActiveCompSection.SaveDialogConfirmText}"
                                Command="{Binding ActiveCompSection.ConfirmSaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 模组前置解析/确认（对应 PCL-CE CompDependency.ConfirmDependencyInstall） -->
        <Panel Grid.ColumnSpan="2"
               IsVisible="{Binding IsDependencyDialogVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="4">
            <Border Classes="dialog-card"
                    Width="580"
                    MaxHeight="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Classes="dialog-title" Text="{Binding ActiveCompSection.DependencyDialogTitle}" />
                    <TextBlock Classes="dialog-body"
                               Margin="0,9,0,0"
                               Text="{Binding ActiveCompSection.DependencyDialogBody}"
                               TextWrapping="Wrap" />

                    <!-- 解析中：不确定态加载动画 + 取消 -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding ActiveCompSection.IsDependencyResolving}">
                        <c:McLoading Width="40" Height="40" />
                        <TextBlock FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   Text="正在查询社区资源，请稍候…" />
                    </StackPanel>

                    <!-- 前置列表 / 未解析原因 -->
                    <ScrollViewer MaxHeight="240"
                                  Margin="0,12,0,0"
                                  IsVisible="{Binding ActiveCompSection.IsDependencyListVisible}">
                        <ItemsControl ItemsSource="{Binding ActiveCompSection.DependencyItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DependencyDialogItemViewModel">
                                    <Border BorderBrush="{DynamicResource Primary6Brush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="2,7">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Title}"
                                                       IsVisible="{Binding IsNormal}" />
                                            <TextBlock FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryDeepBrush}"
                                                       Text="{Binding Title}"
                                                       IsVisible="{Binding IsError}" />
                                            <TextBlock FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Gray2Brush}"
                                                       Text="{Binding Detail}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Margin="0,10,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryDeepBrush}"
                               Text="{Binding ActiveCompSection.DependencyDialogError}"
                               IsVisible="{Binding ActiveCompSection.DependencyDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Classes="mc-btn"
                                MinWidth="88"
                                Content="取消"
                                Command="{Binding ActiveCompSection.CancelDependencyDialogCommand}" />
                        <Button Classes="mc-btn"
                                MinWidth="104"
                                Content="仅下载本体"
                                IsVisible="{Binding ActiveCompSection.IsDependencyInstallVisible}"
                                Command="{Binding ActiveCompSection.ConfirmDependencyWithoutDependenciesCommand}" />
                        <Button Classes="mc-btn primary"
                                MinWidth="104"
                                Content="{Binding ActiveCompSection.DependencyConfirmText}"
                                IsVisible="{Binding ActiveCompSection.IsDependencyInstallVisible}"
                                Command="{Binding ActiveCompSection.ConfirmDependencyWithDependenciesCommand}" />
                        <Button Classes="mc-btn primary"
                                MinWidth="104"
                                Content="继续下载"
                                IsVisible="{Binding ActiveCompSection.IsDependencyContinueVisible}"
                                Command="{Binding ActiveCompSection.ConfirmDependencyWithoutDependenciesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
