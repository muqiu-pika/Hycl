<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.DownloadProgressPage"
             x:DataType="vm:DownloadProgressPageViewModel"
             x:CompileBindings="True">

    <!-- 独立下载进度页：从右下角悬浮图标进入，可返回进入前的页面。
         进度、步骤、文件数据全部复用 InstallTaskViewModel，不另建状态。 -->
    <Grid RowDefinitions="Auto,*" Margin="22,18,18,14">

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Button Classes="mc-btn"
                    Padding="14,4"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Command="{Binding GoBackCommand}"
                    Content="← 返回" />

            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="下载进度"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Border IsVisible="{Binding HasActiveTask}"
                            Background="{DynamicResource Primary8Brush}"
                            CornerRadius="8"
                            Padding="8,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="进行中"
                                   FontSize="11"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource Gray2Brush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="步骤 / 本步 / 总进度与安装链路同源"
                       FontSize="11"
                       Foreground="{DynamicResource Gray2Brush}"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstallTaskViewModel">
                        <Border Background="{DynamicResource GlassSurfaceBrush}"
                                BorderBrush="{DynamicResource Primary6Brush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

                                <!-- 任务头：环形进度 + 任务名/当前步骤 + 总进度 + 取消 -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <c:McProgressRing Width="46"
                                                      Height="46"
                                                      Thickness="3"
                                                      TrackBrush="{DynamicResource Primary8Brush}"
                                                      ProgressBrush="{DynamicResource PrimaryBrush}"
                                                      Percent="{Binding OverallProgressPercent}"
                                                      IsIndeterminate="{Binding IsProgressIndeterminate}" />

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstallingName}"
                                                   FontSize="14.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding StageText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StepProgressText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Gray2Brush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding OverallProgressPercent, StringFormat={}{0:0}%}"
                                                   FontSize="21"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="总进度"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Gray2Brush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Classes="mc-btn danger"
                                            Padding="12,3"
                                            FontSize="12"
                                            Content="取消"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsInstalling}"
                                            Command="{Binding CancelInstallCommand}" />
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                             Value="{Binding OverallProgressPercent}"
                                             Maximum="100"
                                             Height="6" />

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{Binding StepCounterText}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Gray2Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ElapsedText}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Gray2Brush}" />
                                </Grid>

                                <StackPanel Grid.Row="3" Spacing="3">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="当前文件：" Foreground="{DynamicResource Gray2Brush}" />
                                        <Run Text="{Binding CurrentDetailText}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding TransferText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Gray2Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Row="4"
                                           IsVisible="{Binding HasError}"
                                           Text="{Binding ErrorText}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           TextWrapping="Wrap" />

                                <ItemsControl Grid.Row="5"
                                              ItemsSource="{Binding Steps}"
                                              Margin="0,2,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LaunchStepItemViewModel">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        Margin="0,2,14,0">
                                                <TextBlock Classes="step-marker"
                                                           Classes.done="{Binding IsCompleted}"
                                                           Classes.active="{Binding IsActive}"
                                                           Classes.failed="{Binding IsFailed}"
                                                           Text="{Binding Marker}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Classes="step-title"
                                                           Classes.done="{Binding IsCompleted}"
                                                           Classes.active="{Binding IsActive}"
                                                           Classes.failed="{Binding IsFailed}"
                                                           Classes.pending="{Binding IsPending}"
                                                           Text="{Binding Title}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
