<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.DownloadProgressPage"
             x:DataType="vm:DownloadProgressPageViewModel"
             x:CompileBindings="True">

    <!-- 独立下载进度页：从右下角悬浮图标/下载页任务条进入，可返回进入前的页面。
         构图与启动过程页保持一致（图标动画/进度圈 + 步骤清单 + 参数卡 + 总进度），
         进度、步骤、文件数据全部复用 InstallTaskViewModel，不另建状态。
         竖向布局规则（与启动过程页同款）：内容放得下时整体垂直居中，顶部仍保有最小距离
         （外边距 18 + 内边距 16）；放不下时内容顶对齐、交给外层滚动（MinHeight 绑定视口高度
         实现该切换），滚动条贴启动器右缘 3px。右留白拆两段：外边距 3px + Border 右内边距 33
         补回内容右缘（18+18 = 3+33），文字横向位置不变。 -->
    <Panel>
        <ScrollViewer x:Name="ContentScroller"
                      Classes="progress-page"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      Margin="22,18,3,14">
            <Grid MinHeight="{Binding #ContentScroller.Bounds.Height}">
                <Border Padding="18,16,33,16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">

            <Button Classes="mc-btn"
                    Padding="14,4"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Command="{Binding GoBackCommand}"
                    Content="← 返回" />

            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="下载进度"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Border IsVisible="{Binding HasActiveTask}"
                            Background="{DynamicResource Primary8Brush}"
                            CornerRadius="8"
                            Padding="8,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="进行中"
                                   FontSize="11"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource Gray2Brush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="步骤 / 本步 / 总进度与安装链路同源"
                       FontSize="11"
                       Foreground="{DynamicResource Gray2Brush}"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Margin="0,6,0,4">

                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstallTaskViewModel">
                            <StackPanel Margin="0,0,0,16">

                                <!-- 任务头：等待弹跳 / 进度圈（圈心为版本/资源图标） + 任务名 + 步骤 + 总进度 -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                    <Panel Width="52"
                                           Height="52"
                                           VerticalAlignment="Center">
                                        <!-- 还没有真实进度：复用启动页的「图标像球一样弹跳」动画 -->
                                        <c:McLoading IconSize="26"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     IsVisible="{Binding IsProgressIndeterminate}" />
                                        <Panel IsVisible="{Binding !IsProgressIndeterminate}">
                                            <c:McProgressRing Width="52"
                                                              Height="52"
                                                              Thickness="4"
                                                              TrackBrush="{DynamicResource Primary8Brush}"
                                                              ProgressBrush="{DynamicResource PrimaryBrush}"
                                                              Percent="{Binding OverallProgressPercent}" />
                                            <c:TaskIcon Size="36"
                                                        Kind="{Binding TaskIconKey}"
                                                        Url="{Binding TaskIconUrl}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                        </Panel>
                                    </Panel>

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstallingName}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <c:FadeTextBlock Text="{Binding StageText}"
                                                         FontSize="12"
                                                         Foreground="{DynamicResource PrimaryBrush}"
                                                         TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StepProgressText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Gray3Brush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding OverallProgressPercent, StringFormat={}{0:0}%}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="总进度"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Gray2Brush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Classes="mc-btn danger"
                                            Padding="12,3"
                                            FontSize="12"
                                            Content="取消"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsInstalling}"
                                            Command="{Binding CancelInstallCommand}" />
                                </Grid>

                                <!-- 完成 / 失败 / 取消：收尾状态条，文案各自区分 -->
                                <Border IsVisible="{Binding IsCompleted}"
                                        Background="{DynamicResource Primary8Brush}"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="✓"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="下载完成"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding IsFinishedWithError}"
                                        Background="{DynamicResource ErrorSoftBrush}"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="!"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource ErrorBrush}" />
                                        <c:FadeTextBlock Text="{Binding StageText}"
                                                         FontSize="12"
                                                         Foreground="{DynamicResource ErrorBrush}" />
                                        <TextBlock Text="{Binding ErrorText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 七步流程：已完成 ✓ / 当前高亮 / 未开始置灰（与启动过程页同款步骤卡） -->
                                <Border Classes="proc-card" Margin="0,14,0,0">
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LaunchStepItemViewModel">
                                                <Grid ColumnDefinitions="20,*,Auto" Margin="0,2.5">
                                                    <TextBlock Classes="step-marker"
                                                               Classes.done="{Binding IsCompleted}"
                                                               Classes.active="{Binding IsActive}"
                                                               Classes.failed="{Binding IsFailed}"
                                                               Text="{Binding Marker}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="step-title"
                                                               Classes.done="{Binding IsCompleted}"
                                                               Classes.active="{Binding IsActive}"
                                                               Classes.failed="{Binding IsFailed}"
                                                               Classes.pending="{Binding IsPending}"
                                                               Text="{Binding Title}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="完成"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               IsVisible="{Binding IsCompleted}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- 当前文件 / 传输量 / 步骤计数 / 耗时 -->
                                <Border Classes="proc-card" Margin="0,10,0,0">
                                    <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="param-label" Text="当前步骤" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="param-value" Text="{Binding StepCounterText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="param-label" Text="当前文件" />
                                        <c:FadeTextBlock Grid.Row="1"
                                                         Grid.Column="1"
                                                         Classes="param-value"
                                                         Text="{Binding CurrentDetailText}"
                                                         TextTrimming="CharacterEllipsis"
                                                         ToolTip.Tip="{Binding CurrentDetailText}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="param-label" Text="传输量" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="param-value" Text="{Binding TransferText}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="param-label" Text="已耗时" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="param-value" Text="{Binding ElapsedText}" />
                                    </Grid>
                                </Border>

                                <ProgressBar Classes="launch-progress"
                                             Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Margin="0,16,0,0"
                                             Value="{Binding OverallProgressPercent}" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding OverallProgressPercent, StringFormat='总进度 {0:0}%'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Gray3Brush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StepCounterText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Gray3Brush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="320" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>
    </Panel>
</UserControl>
