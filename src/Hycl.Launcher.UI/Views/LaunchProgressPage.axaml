<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.LaunchProgressPage"
             x:DataType="vm:LaunchProgressViewModel"
             x:CompileBindings="True">

    <!-- 独立「启动中」页面：不是弹窗、不是覆盖层，随标签页使用既有的串行淡入淡出 -->
    <Panel>

        <!-- ─────────────── 启动中 ─────────────── -->
        <StackPanel MaxWidth="600"
                    Margin="40,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !Launch.IsLaunchFailed}">

            <c:McLoading IconSize="64"
                         HorizontalAlignment="Center" />

            <TextBlock Text="{Binding Launch.LaunchStageText}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,16,0,0" />

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        Margin="0,7,0,0">
                <TextBlock Text="{Binding Launch.ActiveProfile.Name}"
                           FontSize="12.5"
                           Foreground="{DynamicResource Gray3Brush}" />
                <TextBlock Text="·" FontSize="12.5" Foreground="{DynamicResource Gray3Brush}" />
                <TextBlock Text="{Binding Launch.SelectedInstanceName}"
                           FontSize="12.5"
                           Foreground="{DynamicResource Gray3Brush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ProgressBar Classes="launch-progress"
                         Height="6"
                         Minimum="0"
                         Maximum="1"
                         Margin="0,24,0,0"
                         Value="{Binding Launch.LaunchProgress}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Text="{Binding Launch.LaunchProgress, StringFormat='启动进度 {0:P0}'}"
                           FontSize="12"
                           Foreground="{DynamicResource Gray3Brush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Launch.LaunchElapsedText}"
                           FontSize="12"
                           Foreground="{DynamicResource Gray3Brush}" />
            </Grid>

            <Button Classes="mc-btn"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Command="{Binding Launch.ToggleLaunchLogCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:HyclIcon Kind="list" Width="15" Height="15" />
                    <TextBlock Text="实时日志（点击展开/收起）" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Background="{DynamicResource Gray8Brush}"
                    BorderBrush="{DynamicResource Gray6Brush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,10,0,0"
                    IsVisible="{Binding Launch.IsLaunchLogExpanded}">
                <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding Launch.LaunchLogText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             FontFamily="Consolas, Cascadia Code, monospace"
                             FontSize="12"
                             Foreground="{DynamicResource Gray2Brush}" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- ─────────────── 启动失败 ─────────────── -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Launch.IsLaunchFailed}">
            <StackPanel MaxWidth="640"
                        Margin="48,32"
                        HorizontalAlignment="Center">

                <c:HyclIcon Kind="info"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource ErrorBrush}" />

                <TextBlock Text="{Binding Launch.LaunchFailure.Title}"
                           FontSize="22"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,14,0,0" />

                <TextBlock Text="{Binding Launch.LaunchFailure.Reason}"
                           FontSize="13.5"
                           LineHeight="21"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Gray2Brush}"
                           Margin="0,8,0,0" />

                <Border Background="{DynamicResource GlassSurfaceBrush}"
                        BorderBrush="{DynamicResource SoftLineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,18,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="建议操作"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{Binding Launch.LaunchFailure.Suggestion}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Launch.LaunchFailureExitText}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Gray3Brush}"
                           Margin="0,14,0,0" />

                <!-- 失败后原始日志固定展示，可选中复制 / 一键复制 -->
                <Border Background="{DynamicResource Gray8Brush}"
                        BorderBrush="{DynamicResource Gray6Brush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,10,0,0">
                    <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Launch.LaunchLogText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontFamily="Consolas, Cascadia Code, monospace"
                                 FontSize="12"
                                 Foreground="{DynamicResource Gray2Brush}" />
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <Button Classes="mc-btn"
                            Content="返回启动页"
                            Command="{Binding Launch.ReturnToLaunchPageCommand}" />
                    <Button Classes="mc-btn"
                            Content="重新启动"
                            Command="{Binding Launch.RetryLaunchCommand}" />
                    <Button Classes="mc-btn"
                            Content="复制日志"
                            Click="OnCopyLogClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
