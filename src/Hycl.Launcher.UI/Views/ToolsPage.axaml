<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.ToolsPage"
             x:DataType="vm:ToolsPageViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="page-heading" Text="工具" Margin="22,18,18,0" />

        <!-- 空状态：当前没有可用工具，不保留任何旧卡片或占位功能 -->
        <TextBlock Grid.Row="1"
                   Text="暂无工具"
                   FontSize="13"
                   Foreground="{DynamicResource Gray3Brush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,32" />
    </Grid>
</UserControl>
