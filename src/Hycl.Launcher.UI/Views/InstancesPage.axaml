<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:g="clr-namespace:Hycl.Launcher.Core.Game;assembly=Hycl.Launcher.Core"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.InstancesPage"
             x:DataType="vm:InstancesViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="ListBox.instance-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.instance-list ListBoxItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.instance-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BlockButtonHoverBrush}" />
        </Style>
        <Style Selector="ListBox.instance-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource BlockButtonSelectedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220,*">
        <!-- 左栏：版本列表（图标 + 名称/加载器，右侧「当前」角标） -->
        <Border Classes="page-divider">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="14,16,12,8" Spacing="8">
                    <TextBlock Classes="page-heading" Text="版本管理" Margin="2,0,0,0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding InstanceCountText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="mc-btn"
                                Padding="8,3"
                                MinHeight="0"
                                FontSize="11.5"
                                Content="刷新"
                                Command="{Binding RefreshCommand}" />
                    </Grid>
                    <!-- 导入整合包：文件（zip/mrpack）与已解压文件夹两种入口 -->
                    <Button Classes="mc-btn primary"
                            HorizontalAlignment="Stretch"
                            Padding="8,5"
                            MinHeight="0"
                            FontSize="11.5"
                            Content="导入整合包"
                            Command="{Binding ImportModpackCommand}" />
                    <Button Classes="mc-btn"
                            HorizontalAlignment="Stretch"
                            Padding="8,4"
                            MinHeight="0"
                            FontSize="11"
                            Content="从文件夹导入"
                            Command="{Binding ImportModpackFolderCommand}" />
                </StackPanel>

                <ScrollViewer Name="InstanceScroll"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,10,12">
                        <ListBox Name="InstanceList"
                                 Classes="instance-list"
                                 ItemsSource="{Binding Instances}"
                                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                 IsVisible="{Binding HasInstances}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="g:MinecraftInstance">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="上移"
                                                          Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).MoveInstanceCommand}"
                                                          CommandParameter="up" />
                                                <MenuItem Header="下移"
                                                          Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).MoveInstanceCommand}"
                                                          CommandParameter="down" />
                                                <Separator />
                                                <MenuItem Header="删除该实例…"
                                                          Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).RequestDeleteForCommand}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <!-- 图标位固定 28x28，不随文字挤压；无位图资源时用通用矢量图标兜底 -->
                                        <Panel Width="28" Height="28" VerticalAlignment="Center">
                                            <c:BlockIcon Kind="{Binding IconKey}"
                                                         Width="26"
                                                         Height="26"
                                                         IsVisible="{Binding HasBitmapIcon}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                            <c:HyclIcon Kind="package"
                                                        Width="18"
                                                        Height="18"
                                                        IsVisible="{Binding UsesFallbackIcon}"
                                                        Foreground="{DynamicResource Gray2Brush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                        </Panel>
                                        <StackPanel Grid.Column="1"
                                                    Margin="9,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Spacing="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ListSubText}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Gray2Brush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding IsCurrent}"
                                                VerticalAlignment="Center"
                                                Padding="6,2"
                                                CornerRadius="5"
                                                Background="{DynamicResource Primary8Brush}">
                                            <TextBlock Text="当前"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource PrimaryDeepBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock IsVisible="{Binding IsEmpty}"
                                   Margin="6,18,6,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   Text="尚未安装版本。请到「下载」页安装游戏，安装完成后会自动出现在这里。" />

                        <!-- 导入进度：长任务期间给出阶段文字与百分比，避免看起来卡死 -->
                        <StackPanel IsVisible="{Binding IsImporting}" Margin="6,12,6,0" Spacing="5">
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding ImportPercentage}"
                                         Height="6" />
                            <TextBlock Text="{Binding ImportStageText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Gray2Brush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右栏：实例管理（左侧分区导航 + 右侧内容，对齐 PCL-CE PageInstance） -->
        <Grid Grid.Column="1" ColumnDefinitions="158,*">
            <Border Classes="page-divider" IsVisible="{Binding HasInstances}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,10,10,12" Spacing="2">
                        <TextBlock Classes="side-cat" Text="游戏本体" />
                        <Button Classes="side-item" Classes.active="{Binding IsOverviewSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="overview">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="blocks" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="概览" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsSetupSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="setup">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="settings" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="设置" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsModifySection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="modify">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="wrench" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="修改" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsExportSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="export">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="archive" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="导出" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <TextBlock Classes="side-cat" Text="游戏资源" Margin="0,10,0,4" />
                        <Button Classes="side-item" Classes.active="{Binding IsSavesSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="saves">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="globe" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="存档" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsScreenshotsSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="screenshots">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="image" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="截图" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsModsSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="mods">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="forge" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="模组" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsResourcePacksSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="resourcepacks">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="cobblestone" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="资源包" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsShaderPacksSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="shaderpacks">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="gold-block" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="光影包" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsSchematicsSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="schematics">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="map" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="投影原理图" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="side-item" Classes.active="{Binding IsServersSection}"
                                Command="{Binding SelectInstanceSectionCommand}" CommandParameter="servers">
                            <Grid ColumnDefinitions="Auto,*">
                                <c:HyclIcon Kind="network" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="服务器" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Panel Grid.Column="1" Margin="18,18,18,18">
            <ScrollViewer Name="DetailScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Panel>
                    <StackPanel IsVisible="{Binding HasInstances}">
                        <!-- 标题：大图标 + 名称/加载器 + 版本类型 -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                            <Border Width="46" Height="46"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GlassSurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Panel>
                                    <c:BlockIcon Kind="{Binding SelectedIconKey}"
                                                 Width="32"
                                                 Height="32"
                                                 IsVisible="{Binding SelectedHasBitmapIcon}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    <c:HyclIcon Kind="package"
                                                Width="20"
                                                Height="20"
                                                IsVisible="{Binding SelectedUsesFallbackIcon}"
                                                Foreground="{DynamicResource Gray2Brush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,10,0"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                <TextBlock Text="{Binding SelectedName}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedDescription}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Gray2Brush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Padding="9,4"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BlockButtonSelectedBrush}">
                                <TextBlock Text="{Binding SelectedTypeLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource PrimaryDeepBrush}" />
                            </Border>
                        </Grid>

                        <!-- 1. 基础信息 -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsOverviewSection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="基础信息" />
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="游戏版本" />
                                    <TextBlock Grid.Column="1" Classes="srow-value" Text="{Binding SelectedGameVersion}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="加载器" />
                                    <TextBlock Grid.Column="1" Classes="srow-value" Text="{Binding SelectedLoaderLabel}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="安装目录" />
                                    <TextBlock Grid.Column="1"
                                               Classes="srow-value"
                                               Text="{Binding SelectedPath}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="启动次数" />
                                    <TextBlock Grid.Column="1" Classes="srow-value" Text="{Binding SelectedLaunchCountText}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="最后修改" />
                                    <TextBlock Grid.Column="1" Classes="srow-value" Text="{Binding SelectedLastWrite}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="备注" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorRemark, Mode=TwoWay}"
                                             PlaceholderText="仅启动器内显示，例如：整合包测试" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. 启动设置：内存 / JVM / Java / 窗口（留空跟随全局） -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsSetupSection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="启动设置" />
                                <Border Classes="setting-card-rule" />
                                <TextBlock Classes="sline"
                                           Margin="0,0,0,10"
                                           Text="留空的项目跟随全局启动设置。" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="最大内存" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorMemoryText, Mode=TwoWay}"
                                             PlaceholderText="MB，例如 4096" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="初始内存" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorInitialMemoryText, Mode=TwoWay}"
                                             PlaceholderText="MB，留空由游戏自动选择" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="JVM 参数" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorJvmArguments, Mode=TwoWay}"
                                             PlaceholderText="留空使用全局参数" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="附加游戏参数" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorGameArguments, Mode=TwoWay}"
                                             PlaceholderText="留空使用全局参数，例如 --fullscreen" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="游戏窗口标题" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorWindowTitle, Mode=TwoWay}"
                                             ToolTip.Tip="支持 {name} 实例名、{user} 玩家名、{login} 登录方式、{version} 版本号、{date} 日期、{time} 时间"
                                             PlaceholderText="留空跟随全局，例如 {name} | 玩家 : {user}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="自定义版本信息" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorTypeInfo, Mode=TwoWay}"
                                             PlaceholderText="留空跟随全局（显示在游戏左下角与 F3）" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="自动进服地址" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditorServerToEnter, Mode=TwoWay}"
                                             PlaceholderText="例如 play.example.com:25565，留空不自动进服" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="Java 路径" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="stext"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EditorJavaPath, Mode=TwoWay}"
                                                 PlaceholderText="留空使用全局 Java" />
                                        <Button Grid.Column="1"
                                                Classes="mc-btn"
                                                Content="浏览…"
                                                Command="{Binding BrowseJavaPathCommand}" />
                                    </Grid>
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="窗口模式" />
                                    <c:McComboBox Grid.Column="1"
                                                  Width="210"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Items="{Binding WindowTypeOptions}"
                                                  SelectedItem="{Binding EditorWindowTypeOption, Mode=TwoWay}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="窗口尺寸" />
                                    <Grid Grid.Column="1" ColumnDefinitions="96,18,96,*">
                                        <TextBox Classes="stext"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EditorWindowWidthText, Mode=TwoWay}"
                                                 PlaceholderText="宽" />
                                        <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBox Grid.Column="2"
                                                 Classes="stext"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EditorWindowHeightText, Mode=TwoWay}"
                                                 PlaceholderText="高" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. 目录与隔离 -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsSetupSection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="目录与隔离" />
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="版本隔离" />
                                    <ToggleSwitch Grid.Column="1"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsChecked="{Binding EditorVersionIsolation, Mode=TwoWay}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="内容目录" />
                                    <TextBlock Grid.Column="1"
                                               Classes="srow-value"
                                               Text="{Binding ContentRoot}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="独立存档目录" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="stext"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding EditorSavesDirectory, Mode=TwoWay}"
                                                 PlaceholderText="留空使用隔离规则下的 saves" />
                                        <Button Grid.Column="1"
                                                Classes="mc-btn"
                                                Content="浏览…"
                                                Command="{Binding BrowseSavesDirectoryCommand}" />
                                    </Grid>
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="目录入口" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Classes="mc-btn" Margin="0,2,6,2" Content="模组" Command="{Binding OpenModsFolderCommand}" />
                                        <Button Classes="mc-btn" Margin="0,2,6,2" Content="资源包" Command="{Binding OpenResourcePacksFolderCommand}" />
                                        <Button Classes="mc-btn" Margin="0,2,6,2" Content="光影" Command="{Binding OpenShaderPacksFolderCommand}" />
                                        <Button Classes="mc-btn" Margin="0,2,0,2" Content="存档" Command="{Binding OpenSavesFolderCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3.5 本地存档：列表 / 复制 / 删除 / 打开目录（落点随隔离与独立存档目录变化） -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsSavesSection}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="setting-card-title" Text="{Binding SavesTitleText}" />
                                    <Button Grid.Column="1"
                                            Classes="mc-btn"
                                            MinHeight="0"
                                            Padding="8,3"
                                            FontSize="11.5"
                                            Content="刷新"
                                            Command="{Binding RefreshSavesCommand}" />
                                </Grid>
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="存档目录" />
                                    <TextBlock Grid.Column="1"
                                               Classes="srow-value"
                                               Text="{Binding SavesDirectory}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock IsVisible="{Binding !HasSaves}"
                                           Margin="0,4,0,2"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Gray2Brush}"
                                           Text="{Binding SavesEmptyText}" />
                                <ItemsControl IsVisible="{Binding HasSaves}" ItemsSource="{Binding Saves}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="g:LocalSaveInfo">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,5">
                                                <c:HyclIcon Kind="bookmark"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource Gray2Brush}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Info}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Gray2Brush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Classes="mc-btn"
                                                            MinHeight="0"
                                                            Padding="9,3"
                                                            FontSize="11.5"
                                                            Content="打开"
                                                            Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).OpenSaveCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="mc-btn"
                                                            MinHeight="0"
                                                            Padding="9,3"
                                                            FontSize="11.5"
                                                            Content="复制"
                                                            Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).CopySaveCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="mc-btn danger"
                                                            MinHeight="0"
                                                            Padding="9,3"
                                                            FontSize="11.5"
                                                            Content="删除"
                                                            Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).DeleteSaveCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 4. 启动与目录（概览） -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsOverviewSection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="启动与目录" />
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="当前使用" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Gray2Brush}"
                                                   IsVisible="{Binding IsSelectedCurrent}"
                                                   Text="已是当前版本" />
                                        <Button Classes="mc-btn line-btn"
                                                Content="设为当前版本"
                                                IsVisible="{Binding CanSetCurrent}"
                                                Command="{Binding SetCurrentCommand}" />
                                        <Button Classes="mc-btn"
                                                Content="启动"
                                                Command="{Binding LaunchSelectedCommand}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="目录" />
                                    <Button Grid.Column="1"
                                            Classes="mc-btn"
                                            HorizontalAlignment="Left"
                                            Content="打开实例目录"
                                            Command="{Binding OpenInstanceFolderCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4.5 保存设置（设置页底部） -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsSetupSection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="保存" />
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="游戏内设置" />
                                    <c:McComboBox Grid.Column="1"
                                                  Width="210"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Items="{Binding GameSettingsModeOptions}"
                                                  SelectedItem="{Binding EditorGameSettingsMode, Mode=TwoWay}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="实例设置" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="mc-btn" Content="恢复全局设置" Command="{Binding ResetSettingsCommand}" />
                                        <Button Classes="mc-btn primary-soft" Content="保存实例设置" Command="{Binding SaveSettingsCommand}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 5. 修改实例（重命名 / 复制） -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsModifySection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="实例信息" />
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="名称" />
                                    <TextBlock Grid.Column="1" Classes="srow-value" Text="{Binding SelectedName}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="操作" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Classes="mc-btn" Margin="0,2,6,2" Content="重命名" Command="{Binding StartRenameCommand}" />
                                        <Button Classes="mc-btn" Margin="0,2,6,2" Content="复制实例" Command="{Binding StartCopyCommand}" />
                                        <Button Classes="mc-btn" Margin="0,2,0,2" Content="打开实例目录" Command="{Binding OpenInstanceFolderCommand}" />
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Classes="sline"
                                           Margin="0,0,0,2"
                                           Text="重命名会同步修改 versions 下的目录名与配置；复制会生成一个独立实例。" />
                            </StackPanel>
                        </Border>

                        <!-- 6. 导出实例 -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsExportSection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="导出实例" />
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="压缩包名称" />
                                    <TextBox Grid.Column="1"
                                             Classes="stext"
                                             VerticalAlignment="Center"
                                             Text="{Binding Export.ExportName, Mode=TwoWay}"
                                             PlaceholderText="导出 zip 的文件名" />
                                </Grid>
                                <TextBlock Classes="sline" Margin="0,4,0,6" Text="选择要包含的内容：" />
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="模组" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeMods, Mode=TwoWay}" />
                                    <CheckBox Content="资源包" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeResourcePacks, Mode=TwoWay}" />
                                    <CheckBox Content="光影包" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeShaderPacks, Mode=TwoWay}" />
                                    <CheckBox Content="存档" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeSaves, Mode=TwoWay}" />
                                    <CheckBox Content="截图" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeScreenshots, Mode=TwoWay}" />
                                    <CheckBox Content="投影原理图" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeSchematics, Mode=TwoWay}" />
                                    <CheckBox Content="服务器列表" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeServers, Mode=TwoWay}" />
                                    <CheckBox Content="配置" Margin="0,2,14,2" IsChecked="{Binding Export.IncludeConfig, Mode=TwoWay}" />
                                </WrapPanel>
                                <ProgressBar Height="4"
                                             Margin="0,2,0,10"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Export.Progress}"
                                             IsVisible="{Binding Export.IsExporting}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="mc-btn primary-soft"
                                            Content="导出为压缩包"
                                            Command="{Binding Export.ExportCommand}"
                                            IsEnabled="{Binding !Export.IsExporting}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryDeepBrush}"
                                           Text="{Binding Export.StatusMessage}" />
                            </StackPanel>
                        </Border>

                        <!-- 7. 本地内容（截图 / 模组 / 资源包 / 光影 / 投影） -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsFilesSection}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="setting-card-title" Text="本地内容" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Files.CountText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Gray2Brush}"
                                                   VerticalAlignment="Center" />
                                        <Button Classes="mc-btn" MinHeight="0" Padding="8,3" FontSize="11.5"
                                                Content="刷新" Command="{Binding Files.RefreshCommand}" />
                                        <Button Classes="mc-btn" MinHeight="0" Padding="8,3" FontSize="11.5"
                                                Content="打开文件夹" Command="{Binding Files.OpenFolderCommand}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="目录" />
                                    <TextBlock Grid.Column="1" Classes="srow-value" Text="{Binding Files.Directory}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock IsVisible="{Binding !Files.HasItems}"
                                           Margin="0,4,0,2"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Gray2Brush}"
                                           Text="{Binding Files.EmptyText}" />
                                <ItemsControl IsVisible="{Binding Files.HasItems}" ItemsSource="{Binding Files.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LocalContentItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,5">
                                                <Border Width="34" Height="34"
                                                        Margin="0,0,10,0"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource GlassSurfaceBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1">
                                                    <Panel>
                                                        <c:HyclImage Width="34" Height="34"
                                                                     Stretch="UniformToFill"
                                                                     IsVisible="{Binding IsImage}"
                                                                     Url="{Binding PreviewUrl}" />
                                                        <c:HyclIcon Kind="scroll-text"
                                                                    Width="16"
                                                                    Height="16"
                                                                    IsVisible="{Binding !IsImage}"
                                                                    Foreground="{DynamicResource Gray2Brush}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StateText}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource Gray2Brush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Info}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Gray2Brush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Classes="mc-btn"
                                                            MinHeight="0"
                                                            Padding="9,3"
                                                            FontSize="11.5"
                                                            Content="打开"
                                                            Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).Files.OpenItemCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="mc-btn"
                                                            MinHeight="0"
                                                            Padding="9,3"
                                                            FontSize="11.5"
                                                            Content="禁用/启用"
                                                            IsVisible="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).Files.ShowToggle}"
                                                            Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).Files.ToggleCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="mc-btn danger"
                                                            MinHeight="0"
                                                            Padding="9,3"
                                                            FontSize="11.5"
                                                            Content="删除"
                                                            Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).Files.DeleteCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryDeepBrush}"
                                           Text="{Binding Files.StatusMessage}" />
                            </StackPanel>
                        </Border>

                        <!-- 8. 服务器 -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsServersSection}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="setting-card-title" Text="服务器列表" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Servers.CountText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Gray2Brush}"
                                                   VerticalAlignment="Center" />
                                        <Button Classes="mc-btn" MinHeight="0" Padding="8,3" FontSize="11.5"
                                                Content="刷新" Command="{Binding Servers.RefreshCommand}" />
                                        <Button Classes="mc-btn" MinHeight="0" Padding="8,3" FontSize="11.5"
                                                Content="打开文件夹" Command="{Binding Servers.OpenFolderCommand}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="servers.dat" />
                                    <TextBlock Grid.Column="1" Classes="srow-value" Text="{Binding Servers.ServerPath}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="添加服务器" />
                                    <Grid Grid.Column="1" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="stext" VerticalAlignment="Center"
                                                 Text="{Binding Servers.NewServerName, Mode=TwoWay}"
                                                 PlaceholderText="显示名称（可留空）" />
                                        <TextBox Grid.Column="1" Classes="stext" VerticalAlignment="Center"
                                                 Text="{Binding Servers.NewServerIp, Mode=TwoWay}"
                                                 PlaceholderText="play.example.com:25565" />
                                        <Button Grid.Column="2" Classes="mc-btn" Content="添加"
                                                Command="{Binding Servers.AddServerCommand}" />
                                    </Grid>
                                </Grid>
                                <TextBlock IsVisible="{Binding !Servers.HasServers}"
                                           Margin="0,4,0,2"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Gray2Brush}"
                                           Text="还没有保存的服务器；添加后会写入实例的 servers.dat。" />
                                <ItemsControl IsVisible="{Binding Servers.HasServers}" ItemsSource="{Binding Servers.Servers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="g:GameServerEntry">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,5">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Ip}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Gray2Brush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Classes="mc-btn danger"
                                                        MinHeight="0"
                                                        Padding="9,3"
                                                        FontSize="11.5"
                                                        Content="删除"
                                                        Command="{Binding $parent[UserControl].((vm:InstancesViewModel)DataContext).Servers.DeleteServerCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryDeepBrush}"
                                           Text="{Binding Servers.StatusMessage}" />
                            </StackPanel>
                        </Border>

                        <!-- 9. 危险操作（与其它设置分离） -->
                        <Border Classes="setting-card" Margin="0,0,0,14"
                                IsVisible="{Binding IsModifySection}">
                            <StackPanel>
                                <TextBlock Classes="setting-card-title" Text="危险操作" />
                                <Border Classes="setting-card-rule" />
                                <Grid Classes="setting-row" ColumnDefinitions="170,*">
                                    <TextBlock Classes="srow-label" Text="删除实例" />
                                    <Button Grid.Column="1"
                                            Classes="mc-btn danger"
                                            HorizontalAlignment="Left"
                                            Content="删除实例"
                                            Command="{Binding RequestDeleteCommand}" />
                                </Grid>
                                <TextBlock Classes="sline"
                                           Margin="0,0,0,2"
                                           Text="实例目录及其存档、模组会被一并删除，操作不可撤销。当前使用版本被删除后会清空选择。" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,0,0,8"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryDeepBrush}"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="360"
                                Spacing="8">
                        <c:HyclIcon Kind="list" Width="34" Height="34"
                                    Foreground="{DynamicResource Gray3Brush}"
                                    HorizontalAlignment="Center" />
                        <TextBlock Text="暂无已安装版本"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="请先在「下载」页安装游戏版本，安装完成后回到这里切换与配置。"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Gray2Brush}" />
                    </StackPanel>
                </Panel>
            </ScrollViewer>
            </Panel>
        </Grid>

        <!-- 删除确认 -->
        <Panel Grid.ColumnSpan="2"
               IsVisible="{Binding IsConfirmingDelete}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="3">
            <Border Classes="dialog-card"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Classes="dialog-title" Text="删除实例" />
                    <TextBlock Classes="dialog-body"
                               Margin="0,9,0,0"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Gray2Brush}"
                               TextWrapping="Wrap"
                               Text="实例目录及其存档、模组会被一并删除，操作不可撤销。当前使用版本被删除后会清空选择。" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Classes="mc-btn" MinWidth="88" Content="取消" Command="{Binding CancelDeleteCommand}" />
                        <Button Classes="mc-btn danger" MinWidth="104" Content="确认删除" Command="{Binding ConfirmDeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 复制 / 重命名 -->
        <Panel Grid.ColumnSpan="2"
               IsVisible="{Binding IsNameDialogVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="3">
            <Border Classes="dialog-card"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Classes="dialog-title" Text="{Binding NameDialogTitle}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Gray2Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding NameDialogHint}" />
                    <TextBox Margin="0,14,0,0"
                             Text="{Binding NameDialogText, Mode=TwoWay}"
                             PlaceholderText="实例名称（对应 versions 下的目录名）" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Classes="mc-btn" MinWidth="88" Content="取消" Command="{Binding CancelNameDialogCommand}" />
                        <Button Classes="mc-btn primary" MinWidth="104" Content="确定" Command="{Binding ConfirmNameDialogCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
