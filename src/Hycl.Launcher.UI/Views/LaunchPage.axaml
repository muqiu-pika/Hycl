<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:m="clr-namespace:Hycl.Launcher.Core.Models;assembly=Hycl.Launcher.Core"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.LaunchPage"
             x:DataType="vm:LaunchPageViewModel"
             x:CompileBindings="True">

    <!-- 对应网页版 LaunchView：左栏玩家 / 档案（互斥切换），右栏启动 + 快捷方式
         大屏时内容按 MinHeight 绑定视口高度铺满；小屏时整页纵向滚动，不裁切 -->
    <Panel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="300,*" MinHeight="{Binding $parent[ScrollViewer].Bounds.Height}">
            <!-- ================= 左栏（唯一弹性项） ================= -->
            <!-- MinHeight 为按内容量测的极小高度下限：
                 头像 178 + 名称（4+24）28 + 账号行（5+15）20 + 操作按钮（14+32）46 + 启动按钮（16+54）70 = 342
                 卡片内边距 14/16 + 标题 16 + 正文间距 10 = 56 → 内容下限 398，取 400 留 2px 余量
                 低于该高度时由外层 ScrollViewer 纵向滚动，卡片不再压缩内容 -->
            <Grid Margin="18,18,15,18" MinHeight="400">
                <!-- 玩家卡 -->
                <c:McCard Title="玩家" IsVisible="{Binding IsPlayerPanel}">
                    <Grid RowDefinitions="*,Auto">
                        <!-- 玩家信息在剩余空间内垂直居中，底部固定启动按钮 -->
                        <StackPanel VerticalAlignment="Center">
                        <Panel Height="178">
                            <Ellipse Width="168" Height="168"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFE0EAFD" Offset="0" />
                                        <GradientStop Color="#00EAF2FE" Offset="0.7" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="104" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,4">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#2E343D4A" Offset="0" />
                                        <GradientStop Color="#00343D4A" Offset="0.7" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <c:McSkin SkinKey="{Binding ActiveProfile.SkinKey}"
                                      Scale="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,12" />
                        </Panel>

                        <TextBlock Text="{Binding ActiveProfile.Name}"
                                   FontSize="18"
                                   FontWeight="ExtraBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0">
                            <Ellipse Classes="type-dot"
                                     Classes.ms="{Binding ActiveProfile.IsMicrosoft}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProfile.AccountType}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Gray3Brush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Margin="0,14,0,0">
                            <Button Classes="pa-btn" ToolTip.Tip="更换皮肤" Command="{Binding ChangeSkinCommand}">
                                <c:HyclIcon Kind="shirt" Width="16" Height="16" />
                            </Button>
                            <Button Classes="pa-btn" ToolTip.Tip="编辑档案" Command="{Binding EditProfileCommand}">
                                <c:HyclIcon Kind="pencil" Width="16" Height="16" />
                            </Button>
                            <Button Classes="pa-btn" ToolTip.Tip="切换档案" Command="{Binding OpenProfilesCommand}">
                                <c:HyclIcon Kind="arrow-right-left" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                        </StackPanel>

                        <!-- 启动按钮固定在玩家栏底部（蓝色线条框 + 主题色图标/文字） -->
                        <Button Grid.Row="1"
                                x:Name="LaunchButton"
                                Classes="line-btn launch-btn"
                                Classes.launching="{Binding IsLaunching}"
                                Classes.running="{Binding IsGameRunning}"
                                Classes.closing="{Binding IsClosing}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Margin="0,16,0,0"
                                Command="{Binding LaunchCommand}"
                                IsEnabled="{Binding PrimaryEnabled}">
                            <Panel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Center">
                                        <c:HyclIcon Kind="{Binding LaunchIconKey}"
                                                    Width="17"
                                                    Height="17"
                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LaunchText}"
                                                   Classes="launch-title"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LaunchSubText}"
                                               Classes="launch-sub"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <!-- 阶段式进度条贴在按钮底边，不参与内容布局、不改变按钮尺寸 -->
                                <ProgressBar Classes="launch-progress"
                                             IsIndeterminate="False"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding LaunchProgress}"
                                             IsVisible="{Binding IsLaunching}"
                                             Height="3"
                                             Margin="14,0"
                                             VerticalAlignment="Bottom" />
                            </Panel>
                        </Button>
                    </Grid>
                </c:McCard>

                <!-- 档案卡（点击「切换档案」后替换玩家卡） -->
                <c:McCard Title="档案" IsVisible="{Binding !IsPlayerPanel}">
                    <StackPanel>
                        <Button Classes="back-btn" Command="{Binding CloseProfilesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <c:HyclIcon Kind="chevron-left" Width="15" Height="15" />
                                <TextBlock Text="返回玩家" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:PlayerProfileViewModel">
                                    <Button Classes="profile-row"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].((vm:LaunchPageViewModel)DataContext).SelectProfileCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="pr-avatar">
                                                <c:McSkin SkinKey="{Binding SkinKey}"
                                                          Mode="Head"
                                                          Scale="4"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AccountType}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Gray3Brush}"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                            <c:HyclIcon Grid.Column="2"
                                                        Kind="check"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        IsVisible="{Binding IsActive}"
                                                        VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="new-profile" Command="{Binding NewProfileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:HyclIcon Kind="user-plus" Width="15" Height="15" />
                                <TextBlock Text="创建新档案" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </c:McCard>
            </Grid>

            <!-- ================= 右栏（固定项） ================= -->
            <!-- Auto,Auto + Top：两张卡片按内容取高，窗口变高时底部留空，不拉伸卡片 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Top" Margin="0,18,18,18">
                <!-- 当前版本：仿照 PCL-CE 的版本信息项（图标 + 标签 + 值），只展示版本真实属性 -->
                <c:McCard Title="当前版本" Margin="0,0,0,15">
                    <StackPanel>
                    <Grid ColumnDefinitions="*,*,*">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:HyclIcon Kind="{Binding LoaderIconKey}"
                                        Width="26"
                                        Height="26"
                                        Foreground="{Binding LoaderColor, Converter={StaticResource HexBrush}}"
                                        VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Minecraft"
                                           FontSize="11"
                                           Foreground="{DynamicResource Gray3Brush}" />
                                <TextBlock Text="{Binding CurrentVersion}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                            <c:HyclIcon Kind="bookmark"
                                        Width="24"
                                        Height="24"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="版本类型"
                                           FontSize="11"
                                           Foreground="{DynamicResource Gray3Brush}" />
                                <TextBlock Text="{Binding CurrentVersionTag}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                            <c:HyclIcon Kind="power"
                                        Width="24"
                                        Height="24"
                                        Foreground="{DynamicResource Gray3Brush}"
                                        VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="启动次数"
                                           FontSize="11"
                                           Foreground="{DynamicResource Gray3Brush}" />
                                <TextBlock Text="{Binding LaunchCountText}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 切换当前实例/版本：下拉即写入配置，与版本管理页联动 -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,0">
                        <TextBlock Text="切换版本"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   VerticalAlignment="Center" />
                        <c:McComboBox Grid.Column="1"
                                      Margin="10,0,0,0"
                                      HorizontalAlignment="Stretch"
                                      Items="{Binding InstanceNames}"
                                      SelectedItem="{Binding SelectedInstanceName, Mode=TwoWay}" />
                    </Grid>

                    <!-- 管理实例：蓝色线条框 + 主题色图标/文字 -->
                    <Button Classes="line-btn"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0"
                            Command="{Binding ManageInstanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:HyclIcon Kind="settings"
                                        Width="15"
                                        Height="15"
                                        Foreground="{DynamicResource BlockButtonTextBrush}"
                                        VerticalAlignment="Center" />
                            <TextBlock Text="管理实例" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </c:McCard>

                <c:McCard Grid.Row="1" Title="快捷方式">
                    <ItemsControl ItemsSource="{Binding QuickLinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickLinkViewModel">
                                <Button Classes="quick-row"
                                        Command="{Binding $parent[UserControl].((vm:LaunchPageViewModel)DataContext).ShowQuickLinkCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="quick-icon" VerticalAlignment="Center">
                                            <c:HyclIcon Kind="{Binding IconKey}"
                                                        Width="17"
                                                        Height="17"
                                                        Foreground="{DynamicResource BlockButtonTextBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="11,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BlockButtonNeutralTextBrush}" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Gray3Brush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <c:HyclIcon Grid.Column="2"
                                                    Kind="chevron-right"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource Gray4Brush}"
                                                    VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:McCard>
            </Grid>
    </Grid>
    </ScrollViewer>

        <!-- 关闭游戏确认弹窗：遮罩 + 卡片，Esc 取消 / Enter 确认（键盘处理在代码后置） -->
        <Panel IsVisible="{Binding IsCloseGameConfirmVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="2">
            <Border Classes="dialog-card"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:HyclIcon Kind="power"
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="关闭游戏？"
                                   Classes="dialog-title"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="dialog-body"
                               Margin="0,12,0,0"
                               Text="关闭游戏可能导致未保存的世界进度丢失、存档损坏，正在写入的 MOD 配置也可能损坏。建议先回到游戏内通过菜单正常退出。"
                               TextWrapping="Wrap" />

                    <Border Classes="dialog-warning" Margin="0,14,0,0">
                        <TextBlock Text="若游戏未在 8 秒内正常退出，将强制结束进程。"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button x:Name="CancelCloseButton"
                                Classes="mc-btn"
                                MinWidth="88"
                                Content="取消"
                                Command="{Binding CancelCloseGameCommand}" />
                        <Button x:Name="ConfirmCloseButton"
                                Classes="mc-btn danger"
                                MinWidth="104"
                                Content="确认关闭"
                                Command="{Binding ConfirmCloseGameCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
