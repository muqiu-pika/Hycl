<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Hycl.Launcher.UI.Controls"
             xmlns:m="clr-namespace:Hycl.Launcher.Core.Models;assembly=Hycl.Launcher.Core"
             xmlns:auth="clr-namespace:Hycl.Launcher.Core.Auth;assembly=Hycl.Launcher.Core"
             xmlns:vm="clr-namespace:Hycl.Launcher.Core.ViewModels.Pages;assembly=Hycl.Launcher.Core"
             x:Class="Hycl.Launcher.UI.Views.LaunchPage"
             x:DataType="vm:LaunchPageViewModel"
             x:CompileBindings="True">

    <!-- 对应网页版 LaunchView：左栏玩家 / 档案（互斥切换），右栏启动 + 快捷方式
         顶部保持与顶栏固定间距；底部不设固定长度，内容多长就多长：
         超出视口由整页纵向滚动承载，放得下就原样完整显示 -->
    <UserControl.Styles>
        <!-- 整页纵向滚动条向内收 3px：比原先更贴启动器右缘，仍留 3px 余量不越出圆角窗形 -->
        <Style Selector="ScrollViewer.page-scroll /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>
    </UserControl.Styles>
    <Panel>
    <ScrollViewer Classes="page-scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="300,*">
            <!-- ================= 左栏（顶部对齐，高度随内容，底部不设固定范围） ================= -->
            <!-- MinHeight 为按内容量测的极小高度下限：
                 头像 178 + 名称（12+24）36 + 账号行（4+15）19 + 操作按钮（12+32）44 + 启动按钮（16+54）70 = 347
                 卡片内边距 14/16 + 标题 16 + 正文间距 10 = 56 → 内容下限 403，取 404 留 1px 余量
                 低于该高度时由外层 ScrollViewer 纵向滚动，卡片不再压缩内容；
                 顶部与右栏同为 18 间距，放得下时自然完整显示、不再拉伸到窗口底边 -->
            <Grid Margin="18,18,15,18" MinHeight="404" VerticalAlignment="Top">
                <!-- 玩家卡（无档案时整卡隐藏，改用下方空状态卡） -->
                <c:McCard Title="玩家" IsVisible="{Binding ShowPlayerCard}">
                    <Grid RowDefinitions="*,Auto">
                        <!-- 玩家信息在剩余空间内垂直居中，底部固定启动按钮 -->
                        <StackPanel VerticalAlignment="Center">
                        <Panel Height="178">
                            <Ellipse Width="168" Height="168"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFE0EAFD" Offset="0" />
                                        <GradientStop Color="#00EAF2FE" Offset="0.7" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="104" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,4">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#2E343D4A" Offset="0" />
                                        <GradientStop Color="#00343D4A" Offset="0.7" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <c:McSkin3D SkinKey="{Binding ActiveProfile.SkinKey}"
                                       SkinPath="{Binding ActiveProfile.SkinPath}"
                                       CapePath="{Binding ActiveProfile.CapePath}"
                                       IsSlim="{Binding ActiveProfile.IsSlim}"
                                       AutomationProperties.Name="3D人偶预览"
                                       ToolTip.Tip="移动鼠标转动头部，按住拖动可旋转人偶"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                        </Panel>

                        <TextBlock Text="{Binding PlayerCardName}"
                                   FontSize="18"
                                   FontWeight="ExtraBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0">
                            <Ellipse Classes="type-dot"
                                     Classes.ms="{Binding ActiveProfile.IsMicrosoft}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PlayerCardType}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Gray3Brush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">
                            <!-- 换皮肤 / 改玩家名只对离线档案有意义，正版与皮肤站账号隐藏而不是点了报错 -->
                            <Button Classes="pa-btn"
                                    ToolTip.Tip="更换皮肤"
                                    IsVisible="{Binding ActiveProfile.IsOffline}"
                                    Command="{Binding ChangeSkinCommand}">
                                <c:HyclIcon Kind="shirt" Width="16" Height="16" />
                            </Button>
                            <Button Classes="pa-btn"
                                    ToolTip.Tip="编辑档案"
                                    IsVisible="{Binding ActiveProfile.IsOffline}"
                                    Command="{Binding EditProfileCommand}">
                                <c:HyclIcon Kind="pencil" Width="16" Height="16" />
                            </Button>
                            <Button Classes="pa-btn"
                                    ToolTip.Tip="{Binding ProfileRefreshTip}"
                                    IsVisible="{Binding ProfileRefreshVisible}"
                                    IsEnabled="{Binding CanRefreshProfile}"
                                    Command="{Binding RefreshProfileCommand}">
                                <c:HyclIcon Kind="refresh" Width="16" Height="16" />
                            </Button>
                            <Button Classes="pa-btn" ToolTip.Tip="切换档案" Command="{Binding OpenProfilesCommand}">
                                <c:HyclIcon Kind="arrow-right-left" Width="16" Height="16" />
                            </Button>
                            <Button Classes="pa-btn" ToolTip.Tip="添加账号（正版 / 离线）" Command="{Binding OpenLoginDialogCommand}">
                                <c:HyclIcon Kind="user-plus" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <!-- 刷新资料的失败提示：令牌失效时额外给出「重新登录」入口，不静默失败 -->
                        <StackPanel IsVisible="{Binding HasProfileRefreshError}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <TextBlock Text="{Binding ProfileRefreshError}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Classes="action-btn"
                                    Content="重新登录"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0"
                                    IsVisible="{Binding ProfileRefreshNeedsLogin}"
                                    Command="{Binding ReLoginProfileCommand}" />
                        </StackPanel>
                        </StackPanel>

                        <!-- 启动按钮固定在玩家栏底部（无底色 + 深蓝外框，双层文字） -->
                        <Button Grid.Row="1"
                                x:Name="LaunchButton"
                                Classes="accent-btn"
                                Classes.launching="{Binding IsLaunching}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Margin="0,16,0,0"
                                Command="{Binding LaunchCommand}"
                                IsEnabled="{Binding PrimaryEnabled}">
                            <Panel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Center">
                                        <c:HyclIcon Kind="{Binding LaunchIconKey}"
                                                    Width="18"
                                                    Height="18"
                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LaunchText}"
                                                   Classes="launch-title"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LaunchSubText}"
                                               Classes="launch-sub"
                                               FontSize="12.5"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <!-- 阶段式进度条贴在按钮底边，不参与内容布局、不改变按钮尺寸 -->
                                <ProgressBar Classes="launch-progress"
                                             IsIndeterminate="False"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding LaunchProgress}"
                                             IsVisible="{Binding IsLaunching}"
                                             Height="3"
                                             Margin="14,0"
                                             VerticalAlignment="Bottom" />
                            </Panel>
                        </Button>
                    </Grid>
                </c:McCard>

                <!-- 档案卡（点击「切换档案」后替换玩家卡；无档案时隐藏） -->
                <c:McCard Title="档案" IsVisible="{Binding ShowProfilesCard}">
                    <StackPanel>
                        <Button Classes="back-btn" Command="{Binding CloseProfilesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <c:HyclIcon Kind="chevron-left" Width="15" Height="15" />
                                <TextBlock Text="返回玩家" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 档案列表独立滚动：档案较多时只滚列表，返回与创建入口始终可见。
                             右键菜单提供「批量管理」入口（多选后批量删除） -->
                        <ScrollViewer MaxHeight="264"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="批量管理（多选删除）"
                                              IsVisible="{Binding !IsProfilesMultiSelect}"
                                              Command="{Binding EnterProfilesMultiSelectCommand}" />
                                    <MenuItem Header="退出批量管理"
                                              IsVisible="{Binding IsProfilesMultiSelect}"
                                              Command="{Binding ExitProfilesMultiSelectCommand}" />
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>
                            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,6,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:PlayerProfileViewModel">
                                        <Button Classes="profile-row"
                                                Classes.active="{Binding IsActive}"
                                                Command="{Binding $parent[UserControl].((vm:LaunchPageViewModel)DataContext).ToggleProfileMultiSelectCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Panel Width="34" Height="34">
                                                    <Border Classes="pr-avatar"
                                                            IsVisible="{Binding !$parent[UserControl].((vm:LaunchPageViewModel)DataContext).IsProfilesMultiSelect}">
                                                        <c:McSkin SkinKey="{Binding SkinKey}"
                                                                  SkinPath="{Binding SkinPath}"
                                                                  Mode="Head"
                                                                  Scale="4"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Border>
                                                    <CheckBox IsVisible="{Binding $parent[UserControl].((vm:LaunchPageViewModel)DataContext).IsProfilesMultiSelect}"
                                                              IsChecked="{Binding IsMultiSelected}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AccountType}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Gray3Brush}"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                                <!-- 操作按钮按现有按钮间距（8）排布，小窗口下靠名称列的省略号让位；
                                                     批量管理模式隐藏行内操作，仅保留勾选 -->
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !$parent[UserControl].((vm:LaunchPageViewModel)DataContext).IsProfilesMultiSelect}">
                                                    <c:HyclIcon Kind="check"
                                                                Width="16"
                                                                Height="16"
                                                                Foreground="{DynamicResource PrimaryBrush}"
                                                                IsVisible="{Binding IsActive}"
                                                                VerticalAlignment="Center" />
                                                    <Button Classes="pa-btn"
                                                            ToolTip.Tip="重命名该档案"
                                                            IsVisible="{Binding IsOffline}"
                                                            Command="{Binding $parent[UserControl].((vm:LaunchPageViewModel)DataContext).StartRenameProfileCommand}"
                                                            CommandParameter="{Binding}">
                                                        <c:HyclIcon Kind="pencil" Width="13" Height="13" />
                                                    </Button>
                                                    <Button Classes="pa-btn"
                                                            ToolTip.Tip="删除该档案"
                                                            Command="{Binding $parent[UserControl].((vm:LaunchPageViewModel)DataContext).DeleteProfileCommand}"
                                                            CommandParameter="{Binding}">
                                                        <c:HyclIcon Kind="close" Width="13" Height="13" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 批量管理模式：底部操作条替换「创建新档案」 -->
                        <Button Classes="new-profile" Command="{Binding NewProfileCommand}"
                                IsVisible="{Binding !IsProfilesMultiSelect}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:HyclIcon Kind="user-plus" Width="15" Height="15" />
                                <TextBlock Text="创建新档案" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel IsVisible="{Binding IsProfilesMultiSelect}" Spacing="8">
                            <TextBlock Text="已选择档案用于批量删除（删除后需重新登录正版/皮肤站账号）"
                                       FontSize="11"
                                       Foreground="{DynamicResource Gray3Brush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="mc-btn"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        Content="全选"
                                        Command="{Binding SelectAllProfilesCommand}" />
                                <Button Classes="mc-btn danger"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        Content="删除所选"
                                        Command="{Binding RequestDeleteSelectedProfilesCommand}" />
                                <Button Classes="mc-btn"
                                        MinHeight="0"
                                        Padding="10,4"
                                        FontSize="12"
                                        Content="退出多选"
                                        Command="{Binding ExitProfilesMultiSelectCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </c:McCard>

                <!-- 空档案状态：一个档案都没有时，左栏只显示「添加档案」按钮（D-2） -->
                <c:McCard Title="玩家" IsVisible="{Binding ShowEmptyProfiles}">
                    <Button Classes="new-profile"
                            VerticalAlignment="Center"
                            Command="{Binding OpenLoginDialogCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <c:HyclIcon Kind="user-plus" Width="15" Height="15" />
                            <TextBlock Text="添加档案" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </c:McCard>
            </Grid>

            <!-- ================= 右栏（固定项） ================= -->
            <!-- Auto,Auto + Top：两张卡片按内容取高，窗口变高时底部留空，不拉伸卡片 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Top" Margin="0,18,18,18">
                <!-- 当前版本：仿照 PCL-CE 的版本信息项（图标 + 标签 + 值），只展示版本真实属性 -->
                <c:McCard Title="当前版本" Margin="0,0,0,15">
                    <StackPanel>
                    <!-- 未安装任何版本：不展示“未选择版本”之类的无效字段，改为指向下载页的引导条 -->
                    <Button Classes="quick-row"
                            IsVisible="{Binding !HasInstances}"
                            Command="{Binding GoToDownloadCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="quick-icon" VerticalAlignment="Center">
                                <c:HyclIcon Kind="download"
                                            Width="17"
                                            Height="17"
                                            Foreground="{DynamicResource BlockButtonTextBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                <TextBlock Text="还没有安装任何游戏版本"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BlockButtonNeutralTextBrush}" />
                                <TextBlock Text="点击前往下载页安装第一个版本"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Gray3Brush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <c:HyclIcon Grid.Column="2"
                                        Kind="chevron-right"
                                        Width="14"
                                        Height="14"
                                        Foreground="{DynamicResource Gray3Brush}"
                                        VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <StackPanel IsVisible="{Binding HasInstances}">
                    <Grid ColumnDefinitions="*,*,*">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:BlockIcon Kind="{Binding CurrentIconKey}"
                                         Width="28"
                                         Height="28"
                                         VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LoaderName}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Gray3Brush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentVersion}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding CurrentVersion}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                            <c:HyclIcon Kind="bookmark"
                                        Width="24"
                                        Height="24"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="版本类型"
                                           FontSize="11"
                                           Foreground="{DynamicResource Gray3Brush}" />
                                <TextBlock Text="{Binding CurrentVersionTag}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                            <c:HyclIcon Kind="power"
                                        Width="24"
                                        Height="24"
                                        Foreground="{DynamicResource LaunchCountBrush}"
                                        VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="启动次数"
                                           FontSize="11"
                                           Foreground="{DynamicResource Gray3Brush}" />
                                <TextBlock Text="{Binding LaunchCountText}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 切换当前实例/版本：下拉即写入配置，与版本管理页联动 -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,0">
                        <TextBlock Text="切换版本"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   VerticalAlignment="Center" />
                        <c:McComboBox Grid.Column="1"
                                      Margin="10,0,0,0"
                                      HorizontalAlignment="Stretch"
                                      Items="{Binding InstanceNames}"
                                      SelectedItem="{Binding SelectedInstanceName, Mode=TwoWay}" />
                    </Grid>

                    <!-- 管理实例：次级操作（浅底 + 主色描边，规格与设置页按钮一致） -->
                    <Button Classes="action-btn"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0"
                            Command="{Binding ManageInstanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:HyclIcon Kind="settings"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center" />
                            <TextBlock Text="管理实例" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    </StackPanel>
                </c:McCard>

                <c:McCard Grid.Row="1" Title="快捷方式">
                    <ItemsControl ItemsSource="{Binding QuickLinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickLinkViewModel">
                                <Button Classes="quick-row"
                                        Command="{Binding $parent[UserControl].((vm:LaunchPageViewModel)DataContext).ShowQuickLinkCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="quick-icon" VerticalAlignment="Center">
                                            <c:HyclIcon Kind="{Binding IconKey}"
                                                        Width="17"
                                                        Height="17"
                                                        Foreground="{DynamicResource BlockButtonTextBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="11,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BlockButtonNeutralTextBrush}" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Gray3Brush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <c:HyclIcon Grid.Column="2"
                                                    Kind="chevron-right"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource Gray4Brush}"
                                                    VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:McCard>
            </Grid>
    </Grid>
    </ScrollViewer>

        <!-- 游戏崩溃横幅：非零退出码且找到崩溃报告时显示 -->
        <Border Classes="crash-banner"
                IsVisible="{Binding IsCrashBannerVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,56,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <c:HyclIcon Kind="power"
                            Width="17"
                            Height="17"
                            Foreground="{DynamicResource ErrorBrush}"
                            VerticalAlignment="Center" />
                <TextBlock Text="游戏异常退出，已定位最新崩溃报告"
                           VerticalAlignment="Center"
                           FontSize="12.5" />
                <Button Classes="mc-btn"
                        MinHeight="0"
                        Padding="12,4"
                        FontSize="12"
                        Content="打开报告"
                        Command="{Binding OpenCrashReportCommand}" />
                <Button Classes="pa-btn"
                        VerticalAlignment="Center"
                        Command="{Binding DismissCrashBannerCommand}">
                    <c:HyclIcon Kind="close" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Border>

        <!-- 关闭游戏确认弹窗：遮罩 + 卡片，Esc 取消 / Enter 确认（键盘处理在代码后置） -->
        <Panel IsVisible="{Binding IsCloseGameConfirmVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="2">
            <Border Classes="dialog-card"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:HyclIcon Kind="power"
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="关闭游戏？"
                                   Classes="dialog-title"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="dialog-body"
                               Margin="0,12,0,0"
                               Text="关闭游戏可能导致未保存的世界进度丢失、存档损坏，正在写入的 MOD 配置也可能损坏。建议先回到游戏内通过菜单正常退出。"
                               TextWrapping="Wrap" />

                    <Border Classes="dialog-warning" Margin="0,14,0,0">
                        <TextBlock Text="若游戏未在 8 秒内正常退出，将强制结束进程。"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button x:Name="CancelCloseButton"
                                Classes="mc-btn"
                                MinWidth="88"
                                Content="取消"
                                Command="{Binding CancelCloseGameCommand}" />
                        <Button x:Name="ConfirmCloseButton"
                                Classes="mc-btn danger"
                                MinWidth="104"
                                Content="确认关闭"
                                Command="{Binding ConfirmCloseGameCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 添加账号弹窗：正版（设备码）/ 皮肤站（预留）/ 离线 -->
        <Panel IsVisible="{Binding IsSkinPickerVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="3">
            <Border Classes="dialog-card"
                    Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:HyclIcon Kind="shirt"
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="更换皮肤（离线档案）"
                                   Classes="dialog-title"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="dialog-body"
                               Margin="0,12,0,0"
                               Text="选择 Hycl 内置的一款皮肤，或使用本地皮肤文件（64x32 / 64x64 PNG），仅对当前选中的离线档案生效。"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Classes="skin-option"
                                Command="{Binding ApplySkinCommand}"
                                CommandParameter="steve">
                            <StackPanel Spacing="6">
                                <c:McSkin SkinKey="steve" Scale="4" HorizontalAlignment="Center" />
                                <TextBlock Text="Steve" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="skin-option"
                                Command="{Binding ApplySkinCommand}"
                                CommandParameter="alex">
                            <StackPanel Spacing="6">
                                <c:McSkin SkinKey="alex" Scale="4" HorizontalAlignment="Center" />
                                <TextBlock Text="Alex" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="skin-option"
                                Command="{Binding ApplySkinCommand}"
                                CommandParameter="zuri">
                            <StackPanel Spacing="6">
                                <c:McSkin SkinKey="zuri" Scale="4" HorizontalAlignment="Center" />
                                <TextBlock Text="Zuri" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Classes="mc-btn"
                            MinHeight="34"
                            HorizontalAlignment="Stretch"
                            Margin="0,14,0,0"
                            Content="使用本地皮肤文件…"
                            Click="OnPickLocalSkinClick" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Classes="mc-btn" MinWidth="88" Content="取消" Command="{Binding CloseSkinPickerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 重命名离线档案 -->
        <Panel IsVisible="{Binding IsRenameProfileVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="3">
            <Border Classes="dialog-card"
                    Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:HyclIcon Kind="pencil"
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="编辑档案"
                                   Classes="dialog-title"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="dialog-body"
                               Margin="0,12,0,0"
                               Text="离线档案只能修改玩家名。名称不能与已有离线档案重名（不区分大小写），改名不会影响实例或其他数据。"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,14,0,0">
                        <TextBlock Text="玩家名"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   FontSize="12.5" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding RenameProfileText, Mode=TwoWay}"
                                 PlaceholderText="字母 / 数字 / 下划线，3~16 个字符"
                                 MaxLength="16" />
                    </Grid>

                    <TextBlock Text="{Binding RenameProfileError}"
                               IsVisible="{Binding RenameProfileError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,8,0,0" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Classes="mc-btn" MinWidth="88" Content="取消" Command="{Binding CancelRenameProfileCommand}" />
                        <Button Classes="mc-btn" MinWidth="88" Content="保存" Command="{Binding ConfirmRenameProfileCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 添加账号弹窗：正版（设备码）/ 皮肤站（预留）/ 离线 -->
        <Panel IsVisible="{Binding IsLoginDialogVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="3">
            <Border Classes="dialog-card"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:HyclIcon Kind="user-plus"
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="添加账号"
                                   Classes="dialog-title"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 三个页签：与 PCL-CE 登录窗一致的分组 -->
                    <ListBox Classes="login-tabs"
                             SelectedIndex="{Binding LoginTabIndex, Mode=TwoWay}"
                             Margin="0,14,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem Content="正版登录" />
                        <ListBoxItem Content="皮肤站" />
                        <ListBoxItem Content="离线模式" />
                    </ListBox>

                    <!-- 正版：设备码流 -->
                    <StackPanel IsVisible="{Binding IsMsLoginTab}" Margin="0,14,0,0">
                        <TextBlock Classes="dialog-body"
                                   Text="通过微软官方设备码登录：点击开始后会显示一个代码，浏览器打开 microsoft.com/link 输入即可。Hycl 只使用自研应用身份，不会接触你的密码。"
                                   TextWrapping="Wrap" />

                        <Border Classes="login-code"
                                IsVisible="{Binding HasMsUserCode}"
                                Margin="0,14,0,0"
                                Cursor="Hand"
                                ToolTip.Tip="点击再次复制代码"
                                PointerReleased="OnUserCodeTapped">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="在浏览器中输入此代码"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Gray3Brush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding MsUserCode}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryDeepBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Classes="mc-btn primary"
                                MinHeight="38"
                                HorizontalAlignment="Stretch"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding !IsMsLoginBusy}"
                                Command="{Binding StartMsLoginCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:HyclIcon Kind="user-plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="开始登录" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Classes="line-btn"
                                Height="36"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"
                                IsVisible="{Binding HasMsUserCode}"
                                Command="{Binding OpenMsVerificationPageCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:HyclIcon Kind="globe" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="打开登录页面" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding MsLoginStage}"
                                   IsVisible="{Binding MsLoginStage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- 皮肤站：authlib-injector / Yggdrasil -->
                    <StackPanel IsVisible="{Binding IsAuthlibLoginTab}" Margin="0,14,0,0">
                        <TextBlock Classes="dialog-body"
                                   Text="使用支持 authlib-injector 规范的皮肤站（如 LittleSkin）。填写站点地址与账号，登录后启动游戏时会自动注入。"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,12,0,0">
                            <TextBlock Text="皮肤站"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Gray2Brush}"
                                       FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding AuthlibServerText, Mode=TwoWay}"
                                     PlaceholderText="https://littleskin.cn/api/yggdrasil" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                            <TextBlock Text="账号"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Gray2Brush}"
                                       FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding AuthlibUsernameText, Mode=TwoWay}"
                                     PlaceholderText="皮肤站注册的邮箱或用户名" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                            <TextBlock Text="密码"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Gray2Brush}"
                                       FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding AuthlibPasswordText, Mode=TwoWay}"
                                     PasswordChar="•" />
                        </Grid>

                        <Button Classes="mc-btn primary"
                                MinHeight="38"
                                HorizontalAlignment="Stretch"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding !IsAuthlibLoginBusy}"
                                Command="{Binding StartAuthlibLoginCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:HyclIcon Kind="user-plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="登录皮肤站" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 多角色选择 -->
                        <StackPanel IsVisible="{Binding HasAuthlibProfileOptions}" Margin="0,12,0,0">
                            <TextBlock Text="该账号有多个角色，请选择："
                                       FontSize="12"
                                       Foreground="{DynamicResource Gray2Brush}" />
                            <ListBox Classes="authlib-profiles"
                                     ItemsSource="{Binding AuthlibProfileOptions}"
                                     SelectedItem="{Binding SelectedAuthlibProfile, Mode=TwoWay}"
                                     MaxHeight="120"
                                     Margin="0,6,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="auth:AuthlibProfile">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Classes="mc-btn primary"
                                    MinHeight="34"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Command="{Binding ConfirmAuthlibProfileCommand}"
                                    Content="确认并登录" />
                        </StackPanel>

                        <TextBlock Text="{Binding AuthlibLoginStage}"
                                   IsVisible="{Binding AuthlibLoginStage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Gray2Brush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- 离线：玩家名 -->
                    <StackPanel IsVisible="{Binding IsOfflineLoginTab}" Margin="0,14,0,0">
                        <TextBlock Classes="dialog-body"
                                   Text="离线模式无需网络与账号，玩家名会按原版离线 UUID 规则生成固定身份。"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,14,0,0">
                            <TextBlock Text="玩家名"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Gray2Brush}"
                                       FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding OfflineNameText, Mode=TwoWay}"
                                     PlaceholderText="例如：Steve"
                                     ToolTip.Tip="3 - 16 位，只可以包含英文字母、数字与下划线"
                                     MaxLength="16" />
                        </Grid>
                        <Button Classes="mc-btn primary"
                                MinHeight="38"
                                HorizontalAlignment="Stretch"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding CanAddOfflineAccount}"
                                Command="{Binding AddOfflineAccountCommand}"
                                Content="添加离线档案" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Classes="mc-btn"
                                MinWidth="88"
                                Content="关闭"
                                Command="{Binding CloseLoginDialogCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 正版登录取消二次确认：设备码已显示、登录进行中时点「关闭」先确认（Esc 返回 / Enter 确认取消，键盘处理在代码后置） -->
        <Panel IsVisible="{Binding IsMsCancelConfirmVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="4">
            <Border Classes="dialog-card"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:HyclIcon Kind="power"
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="取消正版登录？"
                                   Classes="dialog-title"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="dialog-body"
                               Margin="0,12,0,0"
                               Text="设备码尚未完成授权，取消后将停止等待并丢弃本次登录，需要重新获取设备码。确定要取消吗？"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button x:Name="CancelMsCancelButton"
                                Classes="mc-btn"
                                MinWidth="88"
                                Content="继续登录"
                                Command="{Binding CancelMsCancelConfirmCommand}" />
                        <Button x:Name="ConfirmMsCancelButton"
                                Classes="mc-btn danger"
                                MinWidth="104"
                                Content="确认取消"
                                Command="{Binding ConfirmCancelMsLoginCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 档案批量删除确认（档案面板 → 批量管理 → 删除所选） -->
        <Panel IsVisible="{Binding IsProfilesDeleteConfirmVisible}"
               Background="{DynamicResource DialogScrimBrush}"
               ZIndex="4">
            <Border Classes="dialog-card"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:HyclIcon Kind="close"
                                    Width="19"
                                    Height="19"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="删除所选档案？"
                                   Classes="dialog-title"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="dialog-body"
                               Margin="0,12,0,0"
                               Text="{Binding SelectedProfilesCount, StringFormat='将删除 {0} 个档案，删除后无法恢复。正版/皮肤站档案的登录凭据会一并清除，再次使用需要重新登录。'}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Classes="mc-btn"
                                MinWidth="88"
                                Content="取消"
                                Command="{Binding CancelDeleteSelectedProfilesCommand}" />
                        <Button Classes="mc-btn danger"
                                MinWidth="104"
                                Content="确认删除"
                                Command="{Binding ConfirmDeleteSelectedProfilesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 运行中：右下角固定悬浮的停止按钮（点击仍走既有的关闭游戏二次确认）。
             下载按钮存在时叠在它上方保持固定间距，只有它自己时贴最底部。 -->
        <Button Classes="stop-fab"
                Classes.dl-offset="{Binding IsFloatingDownloadVisible}"
                x:Name="StopGameButton"
                IsVisible="{Binding IsGameRunning}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                ToolTip.Tip="关闭游戏"
                Command="{Binding RequestCloseGameCommand}">
            <c:HyclIcon Kind="power"
                        Width="20" Height="20"
                        Foreground="#FFFFFFFF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        </Button>
    </Panel>
</UserControl>
