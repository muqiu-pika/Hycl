<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hycl.Launcher.Core</RootNamespace>
    <AssemblyName>Hycl.Launcher.Core</AssemblyName>
    <Product>Hyplay Craft Launcher</Product>
    <Company>Hyplay Craft Launcher</Company>
    <AssemblyTitle>Hyplay Craft Launcher</AssemblyTitle>
    <Description>Hyplay Craft Launcher（HYCL）核心业务层</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hycl.Launcher.PluginContract\Hycl.Launcher.PluginContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BMCLAPI headless Forge/NeoForge/Cleanroom 安装引导器（仅 com.bangbang93.ForgeInstaller.class） -->
    <EmbeddedResource Include="Download\Resources\forge-installer.jar" />
    <!-- PCL-CE 内置的 MC 百科模组译名数据库（GZip + Protobuf，Apache-2.0），用于社区资源中文标题 -->
    <EmbeddedResource Include="Resources\mcmod.buf" />
    <!-- 离线档案内置皮肤（Steve/Alex/Zuri）：更换内置皮肤时落盘到数据目录，
         与本地皮肤同一条链路进游戏（本地 Yggdrasil + authlib-injector），不只是启动器预览 -->
    <EmbeddedResource Include="Resources\Skins\steve.png" />
    <EmbeddedResource Include="Resources\Skins\alex.png" />
    <EmbeddedResource Include="Resources\Skins\zuri.png" />
  </ItemGroup>

</Project>
