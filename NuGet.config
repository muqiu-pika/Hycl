<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 官方源（主源，GitHub Actions 环境可直连） -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- 国内镜像源（v2 协议，国内无法访问 nuget.org 时自动回退） -->
    <add key="Tsinghua" value="https://mirrors.tuna.tsinghua.edu.cn/nuget/" protocolVersion="2" />
  </packageSources>
</configuration>
