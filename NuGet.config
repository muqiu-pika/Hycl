<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 主源：nuget.org 直连（本机系统代理下国内镜像可能返回 502） -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- 国内镜像（无代理环境可按需启用）
    <add key="AzureChina" value="https://nuget.cdn.azure.cn/v3/index.json" protocolVersion="3" />
    <add key="Tsinghua" value="https://mirrors.tuna.tsinghua.edu.cn/nuget/" protocolVersion="2" />
    -->
  </packageSources>
</configuration>
